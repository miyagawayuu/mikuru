<template>
  <label class="mikuru-password-input">
    <span>{{ label }}</span>
    <span class="password-control">
      <input
        :type="visible ? 'text' : 'password'"
        :value="modelValue"
        :placeholder="placeholder"
        :autocomplete="autocomplete"
        :disabled="disabled"
        @input="updateValue($event)"
      />
      <button type="button" @click="toggleVisible">{{ visible ? hideLabel : showLabel }}</button>
    </span>
    <small m-if="strength">{{ strengthLabel }}</small>
  </label>
</template>

<script>
import { computed, ref } from "mikuru";

const {
  label = "Password",
  modelValue = "",
  placeholder = "",
  autocomplete = "current-password",
  disabled = false,
  strength = true,
  showLabel = "Show",
  hideLabel = "Hide"
} = defineProps({
  label: String,
  modelValue: String,
  placeholder: String,
  autocomplete: String,
  disabled: Boolean,
  strength: Boolean,
  showLabel: String,
  hideLabel: String
});

const emit = defineEmits(["update:modelValue", "input"]);
const visible = ref(false);
const strengthLabel = computed(() => {
  const value = modelValue.value || "";
  if (value.length >= 12) return "Strong password";
  if (value.length >= 8) return "Medium password";
  return "Weak password";
});

function toggleVisible() {
  visible.value = !visible.value;
}

function updateValue(event) {
  emit("update:modelValue", event.target.value);
  emit("input", event.target.value);
}
</script>

<style scoped>
.mikuru-password-input {
  display: grid;
  gap: 6px;
  color: #111827;
  font: inherit;
}

.mikuru-password-input > span:first-child {
  font-weight: 650;
}

.password-control {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 8px;
}

input {
  min-width: 0;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  padding: 10px 12px;
  color: #111827;
  background: #ffffff;
  font: inherit;
}

input:focus {
  border-color: #2563eb;
  outline: 3px solid rgb(37 99 235 / 18%);
}

button {
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  padding: 10px 12px;
  color: #111827;
  background: #ffffff;
  font: inherit;
  cursor: pointer;
}

small {
  color: #64748b;
}
</style>
