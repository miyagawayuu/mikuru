<template>
  <Teleport to="body">
    <div
      m-if="open"
      class="alert-backdrop"
      role="presentation"
      @click="handleBackdrop"
    >
      <section
        ref="dialogEl"
        class="mikuru-alert-dialog"
        role="alertdialog"
        aria-modal="true"
        :aria-label="title"
        tabindex="-1"
        @click="stopEvent"
      >
        <header>
          <h2>{{ title }}</h2>
          <p>{{ description }}</p>
        </header>

        <div m-if="body" class="alert-body">
          {{ body }}
        </div>
        <div m-else class="alert-body">
          <slot></slot>
        </div>

        <footer>
          <button class="secondary" type="button" @click="cancel">{{ cancelLabel }}</button>
          <button class="primary" type="button" @click="confirm">{{ confirmLabel }}</button>
        </footer>
      </section>
    </div>
  </Teleport>
</template>

<script>
import { onMounted, onUnmounted, ref, watch } from "mikuru";

const {
  open = false,
  title = "Confirm action",
  description = "This action needs confirmation.",
  body = "",
  confirmLabel = "Confirm",
  cancelLabel = "Cancel",
  closeOnBackdrop = true,
  closeOnEscape = true
} = defineProps({
  open: Boolean,
  title: String,
  description: String,
  body: String,
  confirmLabel: String,
  cancelLabel: String,
  closeOnBackdrop: Boolean,
  closeOnEscape: Boolean
});

const emit = defineEmits(["confirm", "cancel", "close"]);
const dialogEl = ref(null);

onMounted(() => {
  document.addEventListener("keydown", handleDocumentKeydown);
  focusDialog();
});

onUnmounted(() => {
  document.removeEventListener("keydown", handleDocumentKeydown);
});

watch(open, focusDialog);

function focusDialog() {
  requestAnimationFrame(() => {
    if (open.value && dialogEl.value) {
      dialogEl.value.focus();
    }
  });
}

function confirm() {
  emit("confirm");
  emit("close");
}

function cancel() {
  emit("cancel");
  emit("close");
}

function handleBackdrop() {
  if (closeOnBackdrop.value) {
    cancel();
  }
}

function handleDocumentKeydown(event) {
  if (!open.value || !closeOnEscape.value) return;
  if (event.key === "Escape") {
    cancel();
  }
}

function stopEvent(event) {
  event.stopPropagation();
}
</script>

<style scoped>
.alert-backdrop {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgb(15 23 42 / 72%);
}

.mikuru-alert-dialog {
  display: grid;
  gap: 14px;
  width: min(440px, 100%);
  border-radius: 8px;
  padding: 18px;
  color: #111827;
  background: #ffffff;
  box-shadow: 0 24px 80px rgb(15 23 42 / 34%);
  outline: none;
}

header,
.alert-body {
  display: grid;
  gap: 6px;
}

h2,
p {
  margin: 0;
}

h2 {
  font-size: 1.08rem;
}

p,
.alert-body {
  color: #475569;
}

footer {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
}

button {
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  padding: 9px 12px;
  font: inherit;
  cursor: pointer;
}

.secondary {
  color: #111827;
  background: #ffffff;
}

.primary {
  border-color: #dc2626;
  color: #ffffff;
  background: #dc2626;
}

button:focus-visible {
  outline: 3px solid rgb(37 99 235 / 18%);
}
</style>
