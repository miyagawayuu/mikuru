<template>
  <aside class="mikuru-side-menu" :class="{ collapsed: collapsed }" :aria-label="label">
    <div class="side-menu-heading">
      <strong>{{ title }}</strong>
      <button class="collapse-button" m-if="collapsible" type="button" @click="toggleCollapsed" :aria-label="collapsed ? 'Expand menu' : 'Collapse menu'">
        <span class="collapse-icon" :class="collapsed ? 'icon-next' : 'icon-previous'" aria-hidden="true"></span>
      </button>
    </div>

    <nav class="side-menu-nav">
      <button
        m-for="item in normalizedItems"
        :key="item.value"
        class="side-menu-item"
        :class="{ active: Object.is(item.value, modelValue) }"
        type="button"
        :disabled="item.disabled"
        :aria-current="Object.is(item.value, modelValue) ? 'page' : undefined"
        @click="selectItem(item)"
      >
        <span class="item-icon" aria-hidden="true">{{ item.icon }}</span>
        <span class="item-text">{{ item.label }}</span>
        <small m-if="item.badge" class="item-badge">{{ item.badge }}</small>
      </button>
    </nav>
  </aside>
</template>

<script>
import { ref, watch } from "mikuru";

const {
  title = "Menu",
  label = "Side menu",
  items = [],
  modelValue = "",
  collapsed = false,
  collapsible = true
} = defineProps();

const emit = defineEmits(["update:modelValue", "select", "update:collapsed"]);
const normalizedItems = ref([]);
let itemsSignature = "";

watch(items, syncItems, { immediate: true });

function syncItems() {
  const source = Array.isArray(items.value) ? items.value : [];
  const nextItems = source.map((item, index) => {
    if (typeof item === "string") {
      return { label: item, value: item, icon: "", badge: "", disabled: false };
    }
    return {
      label: item.label || `Item ${index + 1}`,
      value: item.value ?? item.label ?? index,
      icon: item.icon || "",
      badge: item.badge || "",
      disabled: Boolean(item.disabled)
    };
  });
  const nextSignature = nextItems
    .map((item) => `${item.value}\u0000${item.label}\u0000${item.icon}\u0000${item.badge}\u0000${item.disabled}`)
    .join("\u0001");
  if (nextSignature === itemsSignature) return;
  itemsSignature = nextSignature;
  normalizedItems.value = nextItems;
}

function selectItem(item) {
  if (item.disabled) return;
  emit("update:modelValue", item.value);
  emit("select", item.value);
}

function toggleCollapsed() {
  emit("update:collapsed", !collapsed.value);
}
</script>

<style scoped>
.mikuru-side-menu {
  display: grid;
  gap: 10px;
  width: 240px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 12px;
  color: #0f172a;
  background: #ffffff;
}

.side-menu-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.collapse-button {
  display: grid;
  width: 30px;
  height: 30px;
  place-items: center;
  border: 1px solid #cbd5e1;
  border-radius: 7px;
  color: #0f172a;
  background: #ffffff;
  font: inherit;
  padding: 0;
  cursor: pointer;
}

.collapse-icon {
  display: block;
  width: 14px;
  height: 14px;
  background: #0f172a;
  mask-position: center;
  mask-repeat: no-repeat;
  mask-size: contain;
}

.icon-previous {
  mask-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M169.4 297.4C156.9 309.9 156.9 330.2 169.4 342.7L361.4 534.7C373.9 547.2 394.2 547.2 406.7 534.7C419.2 522.2 419.2 501.9 406.7 489.4L237.3 320L406.6 150.6C419.1 138.1 419.1 117.8 406.6 105.3C394.1 92.8 373.8 92.8 361.3 105.3L169.3 297.3z"/></svg>');
}

.icon-next {
  mask-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M471.1 297.4C483.6 309.9 483.6 330.2 471.1 342.7L279.1 534.7C266.6 547.2 246.3 547.2 233.8 534.7C221.3 522.2 221.3 501.9 233.8 489.4L403.2 320L233.9 150.6C221.4 138.1 221.4 117.8 233.9 105.3C246.4 92.8 266.7 92.8 279.2 105.3L471.2 297.3z"/></svg>');
}

.side-menu-nav {
  display: grid;
  gap: 4px;
}

.side-menu-item {
  display: grid;
  grid-template-columns: 22px 1fr auto;
  align-items: center;
  gap: 8px;
  border: 0;
  border-radius: 7px;
  padding: 9px 10px;
  color: #475569;
  background: transparent;
  text-align: left;
  font: inherit;
  cursor: pointer;
}

.side-menu-item:hover,
.side-menu-item:focus-visible,
.side-menu-item.active {
  color: #1d4ed8;
  background: #eff6ff;
  outline: none;
}

.side-menu-item:disabled {
  color: #94a3b8;
  cursor: not-allowed;
}

.item-icon {
  text-align: center;
}

.item-badge {
  border-radius: 999px;
  padding: 2px 7px;
  color: #0f172a;
  background: #e2e8f0;
}

.mikuru-side-menu.collapsed {
  width: max-content;
}

.mikuru-side-menu.collapsed .side-menu-heading strong,
.mikuru-side-menu.collapsed .item-text,
.mikuru-side-menu.collapsed .item-badge {
  display: none;
}

.mikuru-side-menu.collapsed .side-menu-item {
  grid-template-columns: 22px;
}
</style>
