  display: grid;
  gap: 16px;
  padding: 14px;
  border: 1px solid #99f6e4;
  border-radius: 8px;
  color: #134e4a;
  background: #f0fdfa;
}

.media-heading {
  display: grid;
  gap: 4px;
}

.media-heading h2,
.media-heading p {
  margin: 0;
}

.component-grid {
  display: grid;
  gap: 14px;
}

.ui-lab {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.ui-panel {
  display: grid;
  align-content: start;
  gap: 12px;
  border: 1px solid #ccfbf1;
  border-radius: 8px;
  padding: 14px;
  background: #ffffff;
}

.ui-panel h3,
.ui-panel p {
  margin: 0;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
}

.actions > button {
  border: 0;
  border-radius: 6px;
  padding: 9px 12px;
  color: #f8fafc;
  background: #0f766e;
  font: inherit;
  cursor: pointer;
}

.layout-demo {
  display: grid;
  gap: 12px;
}

.layout-shell {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 12px;
  align-items: stretch;
}

.layout-content {
  display: grid;
  align-content: start;
  gap: 8px;
  min-height: 160px;
  border: 1px solid #ccfbf1;
  border-radius: 8px;
  padding: 16px;
  color: #134e4a;
  background: #ffffff;
}

.layout-content h3,
.layout-content p {
  margin: 0;
}

.layout-action {
  border: 0;
  border-radius: 7px;
  padding: 8px 11px;
  color: #ffffff;
  background: #0f766e;
  font: inherit;
  cursor: pointer;
}

@media (max-width: 800px) {
  .ui-lab {
    grid-template-columns: 1fr;
  }

  .layout-shell {
    grid-template-columns: 1fr;
  }
}
</style>
