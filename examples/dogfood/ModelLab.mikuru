<template>
  <section class="model-lab" aria-label="m-model lab">
    <div>
      <h2>m-model lab</h2>
      <p>Native modifiers, checkbox arrays, and multiple component models stay in sync.</p>
    </div>

    <label>
      <span>Search phrase</span>
      <input m-model.trim.lazy="phrase" />
    </label>

    <label>
      <span>Priority</span>
      <input type="number" m-model.number="priority" />
    </label>

    <fieldset>
      <legend>Flags</legend>
      <label>
        <input type="checkbox" value="1" m-model.number="flags" />
        One
      </label>
      <label>
        <input type="checkbox" value="2" m-model.number="flags" />
        Two
      </label>
    </fieldset>

    <ModelEditor m-model:title.trim="cardTitle" m-model:checked="cardEnabled" />

    <label>
      <span>Owner name</span>
      <input m-model.trim="ownerName" />
    </label>

    <p class="model-summary">{{ phrase }}:{{ priority }}:{{ flags.join(",") }}:{{ cardTitle }}:{{ cardEnabled }}:{{ ownerFirst }}:{{ ownerLast }}:{{ ownerWatch }}:{{ ownerEffect }}:{{ ownerQueued }}</p>
  </section>
</template>

<script>
import { computed, effect, queueJob, ref, watch, watchEffect } from "mikuru";
import ModelEditor from "./ModelEditor.mikuru";

const phrase = ref("ready");
const priority = ref(1);
const flags = ref([2]);
const cardTitle = ref("Launch checklist");
const cardEnabled = ref(false);
const ownerRaw = ref("Mikuru Runtime");
const ownerWatch = ref("waiting");
const ownerEffect = ref("effect:Mikuru Runtime");
const ownerQueued = ref("queued:Mikuru Runtime");
const ownerFirst = computed(() => ownerRaw.value.split(" ")[0] ?? "");
const ownerLast = computed(() => ownerRaw.value.split(" ").slice(1).join(" "));
const ownerName = computed({
  get: () => ownerRaw.value,
  set: (nextName) => {
    ownerRaw.value = nextName.trim();
  }
});

watch(ownerName, (nextName, previousName) => {
  ownerWatch.value = previousName + " -> " + nextName;
}, { once: true });

watchEffect(() => {
  ownerEffect.value = "effect:" + ownerName.value;
});

effect(() => {
  ownerQueued.value = "queued:" + ownerName.value;
}, { scheduler: queueJob });
</script>

<style scoped>
.model-lab {
  display: grid;
  gap: 10px;
  padding: 14px;
  border: 1px solid #c4b5fd;
  border-radius: 8px;
  color: #4c1d95;
  background: #f5f3ff;
}

.model-lab h2,
.model-lab p {
  margin: 0;
}

.model-lab label,
.model-lab fieldset {
  display: grid;
  gap: 6px;
}

.model-lab fieldset {
  grid-template-columns: repeat(2, max-content);
  align-items: center;
  border: 1px solid #ddd6fe;
  border-radius: 6px;
  padding: 8px;
}

.model-lab legend {
  padding: 0 4px;
}

.model-summary {
  font-weight: 700;
}
</style>
