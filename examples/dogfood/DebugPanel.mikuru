<template>
  <section class="debug-panel" aria-label="Debug panel">
    <header class="debug-header">
      <div>
        <h2>Debug Panel</h2>
        <p>{{ components.length }} components, {{ events.length }} events</p>
      </div>
      <button @click="clearEvents">Clear events</button>
    </header>

    <div class="debug-grid">
      <section class="debug-section">
        <h3>Components</h3>
        <ul v-if="components.length > 0" class="debug-list">
          <li v-for="component in components" :key="component.id">
            <button
              class="debug-component-row"
              :class="{ selected: selected?.id === component.id }"
              @click="selectComponent(component.id)"
            >
              <strong>#{{ component.id }} {{ component.name }}</strong>
              <span>{{ component.filename }}</span>
            </button>
          </li>
        </ul>
        <p v-else class="debug-empty">No debug components yet.</p>
      </section>

      <section class="debug-section">
        <h3>Selected</h3>
        <div v-if="selected" class="debug-detail">
          <strong>{{ selected.name }}</strong>
          <span>{{ selected.filename }}</span>
          <dl>
            <dt>props</dt>
            <dd>{{ selected.propKeys || "none" }}</dd>
            <dt>attrs</dt>
            <dd>{{ selected.attrKeys || "none" }}</dd>
            <dt>children</dt>
            <dd>{{ selected.childIds || "none" }}</dd>
          </dl>
          <pre>{{ selected.propsText }}</pre>
        </div>
        <p v-else class="debug-empty">Select a component.</p>
      </section>

      <section class="debug-section debug-events">
        <h3>Events</h3>
        <ol v-if="events.length > 0" class="debug-event-list">
          <li v-for="event in events" :key="event.id">
            <strong>{{ event.type }}</strong>
            <span>{{ event.summary }}</span>
          </li>
        </ol>
        <p v-else class="debug-empty">No debug events yet.</p>
      </section>
    </div>
  </section>
</template>

<script>
import { computed, createDebugInspector, onBeforeUnmount, ref } from "mikuru/runtime";

const inspector = createDebugInspector();
const components = ref([]);
const events = ref([]);
const selectedId = ref(undefined);

const selected = computed(() =>
  components.value.find((component) => component.id === selectedId.value) ?? components.value[0]
);

function snapshot() {
  components.value = inspector.getComponents().map((component) => ({
    id: component.id,
    name: component.name ?? "anonymous",
    filename: component.filename ?? "unknown",
    propKeys: (component.propKeys ?? []).join(", "),
    attrKeys: (component.attrKeys ?? []).join(", "),
    childIds: Array.from(component.children ?? []).join(", "),
    propsText: JSON.stringify(component.props ?? {}, null, 2)
  }));

  events.value = inspector
    .getEvents()
    .slice(-16)
    .map((event, index) => ({
      id: `${event.timestamp}-${index}-${event.type}`,
      type: event.type,
      summary: summarizeEvent(event)
    }))
    .reverse();

  if (selectedId.value && !components.value.some((component) => component.id === selectedId.value)) {
    selectedId.value = undefined;
  }
}

function summarizeEvent(event) {
  const payload = event.payload ?? {};
  if (payload.status) {
    return String(payload.status);
  }

  if (payload.componentId) {
    return `component #${payload.componentId}`;
  }

  return new Date(event.timestamp).toLocaleTimeString();
}

function selectComponent(id) {
  selectedId.value = id;
}

function clearEvents() {
  inspector.clearEvents();
  snapshot();
}

const unsubscribe = inspector.subscribe(snapshot);
onBeforeUnmount(unsubscribe);
snapshot();
</script>

<style scoped>
.debug-panel {
  display: grid;
  gap: 14px;
  padding: 14px;
  border: 1px solid #c7d2fe;
  border-radius: 8px;
  color: #172554;
  background: #eef2ff;
}

.debug-header,
.debug-grid {
  display: grid;
  gap: 12px;
}

.debug-header {
  grid-template-columns: 1fr auto;
  align-items: start;
}

.debug-header h2,
.debug-header p,
.debug-section h3,
.debug-empty {
  margin: 0;
}

.debug-grid {
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
}

.debug-section {
  display: grid;
  gap: 10px;
  min-width: 0;
}

.debug-events {
  grid-column: 1 / -1;
}

.debug-list,
.debug-event-list {
  display: grid;
  gap: 8px;
  padding: 0;
  margin: 0;
  list-style: none;
}

.debug-component-row {
  display: grid;
  gap: 4px;
  width: 100%;
  padding: 10px;
  text-align: left;
  border: 1px solid #c7d2fe;
  border-radius: 8px;
  color: inherit;
  background: #ffffff;
}

.debug-component-row.selected {
  border-color: #4f46e5;
  box-shadow: inset 3px 0 0 #4f46e5;
}

.debug-component-row span,
.debug-event-list span,
.debug-detail span,
.debug-empty {
  color: #475569;
}

.debug-detail {
  display: grid;
  gap: 8px;
  min-width: 0;
  padding: 10px;
  border: 1px solid #c7d2fe;
  border-radius: 8px;
  background: #ffffff;
}

.debug-detail dl {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 6px 10px;
  margin: 0;
}

.debug-detail dt {
  font-weight: 700;
}

.debug-detail dd {
  margin: 0;
  min-width: 0;
  overflow-wrap: anywhere;
}

.debug-detail pre {
  overflow: auto;
  max-height: 140px;
  padding: 8px;
  margin: 0;
  border-radius: 6px;
  color: #0f172a;
  background: #f8fafc;
}

.debug-event-list li {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 8px 10px;
  border: 1px solid #c7d2fe;
  border-radius: 8px;
  background: #ffffff;
}

@media (max-width: 720px) {
  .debug-header,
  .debug-grid {
    grid-template-columns: 1fr;
  }
}
</style>
