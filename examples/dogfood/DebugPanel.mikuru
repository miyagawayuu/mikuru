<template>
  <section class="debug-panel" aria-label="Debug panel">
    <header class="debug-header">
      <div>
        <h2 m-once>Debug Panel</h2>
        <p>{{ components.length }} components, {{ allEvents.length }} events</p>
      </div>
      <button @click="clearEvents">Clear events</button>
    </header>

    <nav class="debug-filters" aria-label="Debug event filters">
      <button
        m-for="option in filterOptions"
        :key="option.id"
        :class="{ active: eventFilter === option.id }"
        @click="setEventFilter(option.id)"
      >
        {{ option.label }} {{ option.count }}
      </button>
    </nav>

    <div class="debug-grid">
      <section class="debug-section">
        <div class="debug-section-title">
          <h3>Component Tree</h3>
          <div class="debug-actions">
            <button @click="expandAllComponents">Expand all</button>
            <button @click="collapseAllComponents">Collapse all</button>
          </div>
        </div>
        <ul m-if="components.length > 0" class="debug-list">
          <li m-for="component in components" :key="component.id">
            <div class="debug-component-item" :style="{ paddingLeft: component.indent }">
              <button
                m-if="component.childCount > 0"
                class="debug-tree-toggle"
                @click="toggleComponent(component.id)"
              >
                {{ component.collapsed ? "+" : "-" }}
              </button>
              <span m-else class="debug-tree-spacer"></span>
              <button
                class="debug-component-row"
                :class="{ selected: selected?.id === component.id }"
                @click="selectComponent(component.id)"
              >
                <strong>{{ component.branch }} #{{ component.id }} {{ component.name }}</strong>
                <span>{{ component.filename }}</span>
                <span>{{ component.childCount }} children, {{ component.styleCount }} styles, {{ component.eventCount }} events</span>
              </button>
            </div>
          </li>
        </ul>
        <p m-else class="debug-empty">No debug components yet.</p>
      </section>

      <section class="debug-section">
        <h3>Selected</h3>
        <div m-if="selected" class="debug-detail">
          <strong>{{ selected.name }}</strong>
          <span>{{ selected.filename }}</span>
          <div class="debug-actions">
            <button @click="showSelectedComponentEvents">Show component events</button>
            <button :disabled="!selected.hasRoot" @click="revealSelectedRoot">Reveal root</button>
            <button m-if="componentEventFilterId" @click="clearComponentEventFilter">Clear component filter</button>
          </div>
          <dl>
            <dt>status</dt>
            <dd>{{ selected.status }}</dd>
            <dt>root</dt>
            <dd>{{ selected.rootLabel }}</dd>
            <dt>path</dt>
            <dd>{{ selected.rootPath || "none" }}</dd>
            <dt>mounted</dt>
            <dd>{{ selected.mountedLabel }}</dd>
            <dt>props</dt>
            <dd>{{ selected.propKeys || "none" }}</dd>
            <dt>attrs</dt>
            <dd>{{ selected.attrKeys || "none" }}</dd>
            <dt>children</dt>
            <dd>{{ selected.childIds || "none" }}</dd>
            <dt>styles</dt>
            <dd>{{ selected.styleIds || "none" }}</dd>
            <dt>scopes</dt>
            <dd>{{ selected.scopeAttrs || "none" }}</dd>
            <dt>events</dt>
            <dd>{{ selected.eventCount }} total</dd>
            <dt>event types</dt>
            <dd>{{ selected.eventBreakdown || "none" }}</dd>
          </dl>
          <pre>{{ selected.propsText }}</pre>
        </div>
        <p m-else class="debug-empty">Select a component.</p>
      </section>

      <section class="debug-section debug-events">
        <h3>Events {{ filteredEvents.length }} / {{ componentFilteredEvents.length }}</h3>
        <p m-if="componentEventFilterLabel" class="debug-filter-note">{{ componentEventFilterLabel }}</p>
        <ol m-if="filteredEvents.length > 0" class="debug-event-list">
          <li m-for="event in filteredEvents" :key="event.id">
            <button
              class="debug-event-row"
              :class="{ selected: selectedEvent?.id === event.id, warning: event.level === 'warning' }"
              @click="selectEvent(event.id)"
            >
              <strong>{{ event.type }}</strong>
              <span>{{ event.summary }}</span>
            </button>
          </li>
        </ol>
        <p m-else class="debug-empty">No matching debug events.</p>
      </section>

      <section class="debug-section debug-event-detail">
        <h3>Event detail</h3>
        <div m-if="selectedEvent" class="debug-detail">
          <strong>{{ selectedEvent.type }}</strong>
          <span>{{ selectedEvent.summary }}</span>
          <div class="debug-actions" m-if="selectedEvent.componentId">
            <button @click="selectEventComponent">Select component</button>
            <button @click="revealEventComponentRoot">Reveal component root</button>
          </div>
          <dl>
            <dt>category</dt>
            <dd>{{ selectedEvent.category }}</dd>
            <dt>component</dt>
            <dd>{{ selectedEvent.componentLabel || "none" }}</dd>
            <dt>time</dt>
            <dd>{{ selectedEvent.time }}</dd>
          </dl>
          <pre>{{ selectedEvent.payloadText }}</pre>
        </div>
        <p m-else class="debug-empty">Select an event.</p>
      </section>
    </div>
  </section>
</template>

<script>
import { computed, createDebugInspector, onBeforeUnmount, ref } from "mikuru/runtime";

const inspector = createDebugInspector();
const allComponents = ref([]);
const components = ref([]);
const allEvents = ref([]);
const selectedId = ref(undefined);
const selectedEventId = ref(undefined);
const eventFilter = ref("all");
const componentEventFilterId = ref(undefined);
const hideBackgroundEventsAfterClear = ref(false);
const collapsedIds = ref(new Set());

const selected = computed(() =>
  allComponents.value.find((component) => component.id === selectedId.value) ?? components.value[0]
);

const componentFilteredEvents = computed(() =>
  allEvents.value.filter((event) => componentEventFilterId.value === undefined || event.componentId === componentEventFilterId.value)
);

const filteredEvents = computed(() =>
  componentFilteredEvents.value.filter((event) => eventFilter.value === "all" || event.category === eventFilter.value)
);

const selectedEvent = computed(() =>
  filteredEvents.value.find((event) => event.id === selectedEventId.value) ?? filteredEvents.value[0]
);

const componentEventFilterLabel = computed(() => {
  if (componentEventFilterId.value === undefined) {
    return "";
  }

  const component = components.value.find((item) => item.id === componentEventFilterId.value);
  return component ? `Filtered by #${component.id} ${component.name}` : `Filtered by #${componentEventFilterId.value}`;
});

const filterOptions = computed(() => [
  { id: "all", label: "All", count: componentFilteredEvents.value.length },
  { id: "component", label: "Component", count: countEvents("component") },
  { id: "style", label: "Style", count: countEvents("style") },
  { id: "async", label: "Async", count: countEvents("async") },
  { id: "hydration", label: "Hydration", count: countEvents("hydration") },
  { id: "router", label: "Router", count: countEvents("router") },
  { id: "error", label: "Error", count: countEvents("error") }
]);

function snapshot() {
  const events = inspector.getEvents();
  const stylesByComponent = collectStyleEvents(events);
  const eventsByComponent = collectComponentEvents(events);
  const flattenedComponents = flattenComponentTree(inspector.getComponentTree(), stylesByComponent, eventsByComponent);
  allComponents.value = flattenedComponents;
  components.value = filterVisibleComponents(flattenedComponents);

  if (hideBackgroundEventsAfterClear.value && events.some(isForegroundEvent)) {
    hideBackgroundEventsAfterClear.value = false;
  }

  const visibleEvents = hideBackgroundEventsAfterClear.value
    ? events.filter(isForegroundEvent)
    : events;

  allEvents.value = visibleEvents
    .slice(-100)
    .map((event, index) => ({
      id: `${event.timestamp}-${index}-${event.type}`,
      type: event.type,
      category: categorizeEvent(event),
      componentId: event.payload?.componentId,
      componentLabel: formatComponentLabel(event.payload?.componentId, event.payload?.component),
      level: isErrorEvent(event) ? "warning" : "info",
      time: new Date(event.timestamp).toLocaleTimeString(),
      summary: summarizeEvent(event),
      payloadText: stringifyPayload(event.payload ?? {})
    }))
    .reverse();

  if (selectedId.value && !allComponents.value.some((component) => component.id === selectedId.value)) {
    selectedId.value = undefined;
  }

  if (componentEventFilterId.value && !allComponents.value.some((component) => component.id === componentEventFilterId.value)) {
    componentEventFilterId.value = undefined;
  }

  if (selectedEventId.value && !filteredEvents.value.some((event) => event.id === selectedEventId.value)) {
    selectedEventId.value = undefined;
  }
}

function collectComponentEvents(events) {
  const eventsByComponent = new Map();
  for (const event of events) {
    if (event.payload?.componentId === undefined) {
      continue;
    }

    const componentId = event.payload.componentId;
    const category = categorizeEvent(event);
    const counts = eventsByComponent.get(componentId) ?? { total: 0, component: 0, style: 0, async: 0, hydration: 0, router: 0, error: 0 };
    counts.total += 1;
    counts[category] = (counts[category] ?? 0) + 1;
    eventsByComponent.set(componentId, counts);
  }

  return eventsByComponent;
}

function collectStyleEvents(events) {
  const stylesByComponent = new Map();
  for (const event of events) {
    if (event.type !== "style:inject" || event.payload?.componentId === undefined) {
      continue;
    }

    const componentId = event.payload.componentId;
    const style = event.payload.style ?? {};
    const styles = stylesByComponent.get(componentId) ?? [];
    if (!styles.some((item) => item.id === style.id)) {
      styles.push({
        id: style.id ?? "style",
        scopeAttr: style.scopeAttr ?? "",
        scoped: style.scoped === true
      });
    }
    stylesByComponent.set(componentId, styles);
  }

  return stylesByComponent;
}

function flattenComponentTree(tree, stylesByComponent, eventsByComponent, depth = 0, rows = []) {
  for (const component of tree) {
    const childIds = component.childrenTree.map((child) => child.id);
    const styles = stylesByComponent.get(component.id) ?? [];
    const eventCounts = eventsByComponent.get(component.id) ?? { total: 0 };
    rows.push({
      id: component.id,
      name: component.name ?? "anonymous",
      filename: component.filename ?? "unknown",
      branch: depth === 0 ? "root" : "child",
      indent: `${10 + depth * 18}px`,
      depth,
      parentId: component.parentId,
      collapsed: collapsedIds.value.has(component.id),
      childCount: childIds.length,
      styleCount: styles.length,
      eventCount: eventCounts.total,
      eventBreakdown: formatEventBreakdown(eventCounts),
      styleIds: styles.map((style) => style.id).join(", "),
      scopeAttrs: styles.map((style) => style.scopeAttr).filter(Boolean).join(", "),
      hasRoot: isElement(component.root),
      root: component.root,
      rootLabel: formatRootLabel(component.root),
      rootPath: formatRootPath(component.root),
      status: component.unmountedAt ? "unmounted" : "mounted",
      mountedLabel: formatMountedLabel(component.mountedAt, component.unmountedAt),
      propKeys: (component.propKeys ?? []).join(", "),
      attrKeys: (component.attrKeys ?? []).join(", "),
      childIds: childIds.join(", "),
      propsText: JSON.stringify(component.props ?? {}, null, 2)
    });
    flattenComponentTree(component.childrenTree, stylesByComponent, eventsByComponent, depth + 1, rows);
  }

  return rows;
}

function filterVisibleComponents(rows) {
  return rows.filter((component) => {
    let parentId = component.parentId;
    while (parentId !== undefined) {
      if (collapsedIds.value.has(parentId)) {
        return false;
      }

      parentId = rows.find((item) => item.id === parentId)?.parentId;
    }

    return true;
  });
}

function formatEventBreakdown(counts) {
  return ["component", "style", "async", "hydration", "router", "error"]
    .filter((category) => counts[category] > 0)
    .map((category) => `${category}: ${counts[category]}`)
    .join(", ");
}

function summarizeEvent(event) {
  const payload = event.payload ?? {};
  if (payload.diagnostic?.message) {
    return `${payload.diagnostic.phase ?? payload.diagnostic.source ?? event.type}: ${payload.diagnostic.message}`;
  }

  if (event.type === "style:inject") {
    const style = payload.style ?? {};
    const scoped = style.scoped ? "scoped" : "global";
    const size = typeof style.length === "number" ? `${style.length} chars` : "unknown size";
    return `${formatFilename(payload.component?.filename)}: ${style.id ?? "style"} (${scoped}, ${size})`;
  }

  if (event.type === "hydration:warning") {
    return `${payload.kind ?? "hydration"}: ${payload.domPath ?? payload.message ?? "warning"}`;
  }

  if (payload.to?.path || payload.from?.path) {
    return `${payload.from?.path ?? "-"} -> ${payload.to?.path ?? "-"}${payload.status ? ` (${payload.status})` : ""}`;
  }

  if (payload.errorInfo?.phase) {
    return `${payload.errorInfo.phase}: ${formatError(payload.error)}`;
  }

  if (payload.error) {
    return formatError(payload.error);
  }

  if (payload.status) {
    return String(payload.status);
  }

  if (payload.componentId) {
    return `component #${payload.componentId}`;
  }

  return new Date(event.timestamp).toLocaleTimeString();
}

function categorizeEvent(event) {
  if (isErrorEvent(event)) {
    return "error";
  }

  if (event.type.startsWith("route:")) {
    return "router";
  }

  if (event.type.startsWith("async:")) {
    return "async";
  }

  if (event.type.startsWith("hydration:")) {
    return "hydration";
  }

  if (event.type.startsWith("component:")) {
    return "component";
  }

  if (event.type.startsWith("style:")) {
    return "style";
  }

  return "component";
}

function isErrorEvent(event) {
  return event.type.includes("error") || event.type.endsWith(":rejected") || event.type === "hydration:warning";
}

function isForegroundEvent(event) {
  return event.type.startsWith("route:") || event.type.startsWith("hydration:") || isErrorEvent(event);
}

function countEvents(category) {
  return componentFilteredEvents.value.filter((event) => category === "error" ? event.level === "warning" : event.category === category).length;
}

function formatError(error) {
  if (!error) {
    return "unknown";
  }

  return error.message ?? String(error);
}

function formatFilename(filename) {
  if (!filename) {
    return "unknown";
  }

  return String(filename).split(/[\\/]/).pop() ?? String(filename);
}

function formatComponentLabel(componentId, component) {
  if (componentId === undefined) {
    return "";
  }

  return `#${componentId} ${formatFilename(component?.filename ?? component?.component)}`;
}

function isElement(value) {
  return value instanceof Element;
}

function formatRootLabel(root) {
  if (root instanceof Element) {
    const id = root.id ? `#${root.id}` : "";
    const classes = Array.from(root.classList).slice(0, 3).map((name) => `.${name}`).join("");
    return `<${root.tagName.toLowerCase()}${id}${classes}>`;
  }

  if (root instanceof Comment) {
    return "<!--comment-->";
  }

  return "none";
}

function formatRootPath(root) {
  if (!(root instanceof Element)) {
    return "";
  }

  const parts = [];
  let current = root;
  while (current && current.nodeType === Node.ELEMENT_NODE && parts.length < 5) {
    let label = current.tagName.toLowerCase();
    if (current.id) {
      label += `#${current.id}`;
      parts.unshift(label);
      break;
    }

    const className = Array.from(current.classList).find((name) => !name.startsWith("mikuru-") && !name.startsWith("debug-root-highlight"));
    if (className) {
      label += `.${className}`;
    }

    const parent = current.parentElement;
    if (parent) {
      const siblings = Array.from(parent.children).filter((child) => child.tagName === current.tagName);
      if (siblings.length > 1) {
        label += `:nth-of-type(${siblings.indexOf(current) + 1})`;
      }
    }

    parts.unshift(label);
    current = parent;
  }

  return parts.join(" > ");
}

function formatMountedLabel(mountedAt, unmountedAt) {
  if (!mountedAt) {
    return "unknown";
  }

  const end = unmountedAt ?? Date.now();
  const seconds = Math.max(0, Math.round((end - mountedAt) / 1000));
  return unmountedAt ? `${seconds}s before unmount` : `${seconds}s ago`;
}

function stringifyPayload(payload) {
  return JSON.stringify(payload, (_key, value) => {
    if (value instanceof Error) {
      return { name: value.name, message: value.message };
    }

    if (value instanceof Element) {
      return `<${value.tagName.toLowerCase()}>`;
    }

    if (value instanceof Comment) {
      return "<!--comment-->";
    }

    if (value instanceof Set) {
      return Array.from(value);
    }

    if (typeof value === "function") {
      return "[Function]";
    }

    return value;
  }, 2);
}

function selectComponent(id) {
  expandAncestors(id);
  selectedId.value = id;
}

function selectEvent(id) {
  selectedEventId.value = id;
  const event = filteredEvents.value.find((item) => item.id === id);
  if (event?.componentId && allComponents.value.some((component) => component.id === event.componentId)) {
    selectComponent(event.componentId);
  }
}

function setEventFilter(filter) {
  eventFilter.value = filter;
  selectedEventId.value = undefined;
}

function showSelectedComponentEvents() {
  if (!selected.value) {
    return;
  }

  componentEventFilterId.value = selected.value.id;
  selectedEventId.value = undefined;
}

function clearComponentEventFilter() {
  componentEventFilterId.value = undefined;
  selectedEventId.value = undefined;
}

function toggleComponent(id) {
  const next = new Set(collapsedIds.value);
  if (next.has(id)) {
    next.delete(id);
  } else {
    next.add(id);
  }
  collapsedIds.value = next;
  components.value = filterVisibleComponents(allComponents.value);
}

function expandAllComponents() {
  collapsedIds.value = new Set();
  components.value = filterVisibleComponents(allComponents.value);
}

function collapseAllComponents() {
  collapsedIds.value = new Set(allComponents.value.filter((component) => component.childCount > 0).map((component) => component.id));
  if (selected.value) {
    expandAncestors(selected.value.id);
  } else {
    components.value = filterVisibleComponents(allComponents.value);
  }
}

function expandAncestors(id) {
  const next = new Set(collapsedIds.value);
  let parentId = allComponents.value.find((component) => component.id === id)?.parentId;
  while (parentId !== undefined) {
    next.delete(parentId);
    parentId = allComponents.value.find((component) => component.id === parentId)?.parentId;
  }
  collapsedIds.value = next;
  components.value = filterVisibleComponents(allComponents.value);
}

function selectEventComponent() {
  if (!selectedEvent.value?.componentId) {
    return;
  }

  selectComponent(selectedEvent.value.componentId);
}

function revealEventComponentRoot() {
  selectEventComponent();
  revealSelectedRoot();
}

function revealSelectedRoot() {
  const root = selected.value?.root;
  if (!(root instanceof Element)) {
    return;
  }

  root.scrollIntoView({ block: "center", inline: "center", behavior: "instant" });
  root.dataset.mikuruDebugHighlight = "true";
  root.classList.add("debug-root-highlight");
  root.style.outline = "3px solid #e11d48";
  root.style.outlineOffset = "3px";
  window.setTimeout(() => {
    root.classList.remove("debug-root-highlight");
    delete root.dataset.mikuruDebugHighlight;
    root.style.outline = "";
    root.style.outlineOffset = "";
  }, 1200);
}

function clearEvents() {
  inspector.clearEvents();
  componentEventFilterId.value = undefined;
  hideBackgroundEventsAfterClear.value = true;
  snapshot();
}

const unsubscribe = inspector.subscribe(snapshot);
onBeforeUnmount(unsubscribe);
snapshot();
</script>

<style scoped>
.debug-panel {
  display: grid;
  gap: 14px;
  padding: 14px;
  border: 1px solid #c7d2fe;
  border-radius: 8px;
  color: #172554;
  background: #eef2ff;
}

.debug-header,
.debug-filters,
.debug-actions,
.debug-grid {
  display: grid;
  gap: 12px;
}

.debug-header {
  grid-template-columns: 1fr auto;
  align-items: start;
}

.debug-filters {
  grid-template-columns: repeat(6, minmax(0, 1fr));
}

.debug-actions {
  grid-template-columns: repeat(2, minmax(0, max-content));
}

.debug-header h2,
.debug-header p,
.debug-section h3,
.debug-filter-note,
.debug-empty {
  margin: 0;
}

.debug-section-title {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 10px;
  align-items: center;
}

.debug-grid {
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
}

.debug-section {
  display: grid;
  gap: 10px;
  align-content: start;
  min-width: 0;
}

.debug-events {
  grid-column: 1 / -1;
}

.debug-event-detail {
  grid-column: 1 / -1;
}

.debug-list,
.debug-event-list {
  display: grid;
  gap: 8px;
  max-height: 320px;
  overflow: auto;
  padding: 0;
  margin: 0;
  list-style: none;
  scrollbar-gutter: stable;
}

.debug-component-item {
  display: grid;
  grid-template-columns: 26px minmax(0, 1fr);
  gap: 6px;
  align-items: stretch;
}

.debug-tree-toggle,
.debug-tree-spacer {
  width: 26px;
  min-height: 72px;
}

.debug-tree-toggle {
  padding: 0;
  border: 1px solid #c7d2fe;
  border-radius: 8px;
  color: #3730a3;
  background: #ffffff;
}

.debug-component-row {
  display: grid;
  gap: 4px;
  width: 100%;
  min-height: 72px;
  padding: 10px;
  text-align: left;
  border: 1px solid #c7d2fe;
  border-radius: 8px;
  color: inherit;
  background: #ffffff;
}

.debug-component-row.selected,
.debug-event-row.selected,
.debug-filters button.active {
  border-color: #4f46e5;
  box-shadow: inset 3px 0 0 #4f46e5;
}

.debug-component-row.selected,
.debug-event-row.selected {
  color: #1e1b4b;
  background: #e0e7ff;
}

.debug-component-row span,
.debug-event-list span,
.debug-detail span,
.debug-empty {
  color: #475569;
}

.debug-detail {
  display: grid;
  gap: 8px;
  align-content: start;
  min-width: 0;
  min-height: 280px;
  padding: 10px;
  border: 1px solid #c7d2fe;
  border-radius: 8px;
  background: #ffffff;
}

.debug-detail dl {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 6px 10px;
  margin: 0;
}

.debug-detail dt {
  font-weight: 700;
}

.debug-detail dd {
  margin: 0;
  min-width: 0;
  overflow-wrap: anywhere;
}

.debug-detail pre {
  overflow: auto;
  max-height: 140px;
  padding: 8px;
  margin: 0;
  border-radius: 6px;
  color: #0f172a;
  background: #f8fafc;
}

.debug-event-row {
  display: flex;
  align-items: start;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
  min-height: 48px;
  padding: 8px 10px;
  text-align: left;
  border: 1px solid #c7d2fe;
  border-radius: 8px;
  color: inherit;
  background: #ffffff;
}

.debug-event-row.warning {
  border-color: #fb923c;
  color: #7c2d12;
  background: #fff7ed;
}

@media (max-width: 720px) {
  .debug-header,
  .debug-filters,
  .debug-actions,
  .debug-section-title,
  .debug-grid {
    grid-template-columns: 1fr;
  }

  .debug-list,
  .debug-event-list {
    max-height: 260px;
  }

  .debug-event-row {
    display: grid;
  }
}
</style>
