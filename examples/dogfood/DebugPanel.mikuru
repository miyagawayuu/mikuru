<template>
  <section class="debug-panel" aria-label="Debug panel">
    <header class="debug-header">
      <div>
        <h2 m-once>Debug Panel</h2>
        <p>{{ components.length }} components, {{ allEvents.length }} events</p>
      </div>
      <button @click="clearEvents">Clear events</button>
    </header>

    <nav class="debug-filters" aria-label="Debug event filters">
      <button
        m-for="option in filterOptions"
        :key="option.id"
        :class="{ active: eventFilter === option.id }"
        @click="setEventFilter(option.id)"
      >
        {{ option.label }} {{ option.count }}
      </button>
    </nav>

    <div class="debug-grid">
      <section class="debug-section">
        <div class="debug-section-title">
          <h3>Component Tree</h3>
          <div class="debug-actions">
            <button @click="expandAllComponents">Expand all</button>
            <button @click="collapseAllComponents">Collapse all</button>
          </div>
        </div>
        <div class="debug-search">
          <input
            aria-label="Component search"
            placeholder="Search components"
            m-model="componentSearch"
          />
          <button m-if="componentSearch" @click="clearComponentSearch">Clear search</button>
        </div>
        <ul m-if="components.length > 0" class="debug-list">
          <li m-for="component in components" :key="component.id">
            <div class="debug-component-item" :style="{ paddingLeft: component.indent }">
              <button
                m-if="component.childCount > 0"
                class="debug-tree-toggle"
                @click="toggleComponent(component.id)"
              >
                {{ component.collapsed ? "+" : "-" }}
              </button>
              <span m-else class="debug-tree-spacer"></span>
              <button
                class="debug-component-row"
                :class="{ selected: selected?.id === component.id }"
                @click="selectComponent(component.id)"
              >
                <strong>{{ component.branch }} #{{ component.id }} {{ component.name }}</strong>
                <span>{{ component.filename }}</span>
                <span>{{ component.childCount }} children, {{ component.styleCount }} styles, {{ component.eventCount }} events</span>
              </button>
            </div>
          </li>
        </ul>
        <p m-else class="debug-empty">No debug components yet.</p>
      </section>

      <section class="debug-section">
        <h3>Selected</h3>
        <div m-if="selected" class="debug-detail">
          <strong>{{ selected.name }}</strong>
          <span>{{ selected.filename }}</span>
          <div class="debug-actions">
            <button @click="showSelectedComponentEvents">Show component events</button>
            <button :disabled="!selected.hasRoot" @click="revealSelectedRoot">Reveal root</button>
            <button m-if="componentEventFilterId" @click="clearComponentEventFilter">Clear component filter</button>
          </div>
          <dl>
            <dt>status</dt>
            <dd>{{ selected.status }}</dd>
            <dt>root</dt>
            <dd>{{ selected.rootLabel }}</dd>
            <dt>path</dt>
            <dd>{{ selected.rootPath || "none" }}</dd>
            <dt>mounted</dt>
            <dd>{{ selected.mountedLabel }}</dd>
            <dt>props</dt>
            <dd>{{ selected.propKeys || "none" }}</dd>
            <dt>attrs</dt>
            <dd>{{ selected.attrKeys || "none" }}</dd>
            <dt>children</dt>
            <dd>{{ selected.childIds || "none" }}</dd>
            <dt>styles</dt>
            <dd>{{ selected.styleIds || "none" }}</dd>
            <dt>scopes</dt>
            <dd>{{ selected.scopeAttrs || "none" }}</dd>
            <dt>events</dt>
            <dd>{{ selected.eventCount }} total</dd>
            <dt>event types</dt>
            <dd>{{ selected.eventBreakdown || "none" }}</dd>
          </dl>
          <pre>{{ selected.propsText }}</pre>
        </div>
        <p m-else class="debug-empty">Select a component.</p>
      </section>

      <section class="debug-section debug-events">
        <h3>Events {{ filteredEvents.length }} / {{ searchedEvents.length }}</h3>
        <div class="debug-search">
          <input
            aria-label="Event search"
            placeholder="Search events"
            m-model="eventSearch"
          />
          <button m-if="eventSearch" @click="clearEventSearch">Clear search</button>
        </div>
        <p m-if="componentEventFilterLabel" class="debug-filter-note">{{ componentEventFilterLabel }}</p>
        <ol m-if="filteredEvents.length > 0" class="debug-event-list">
          <li m-for="event in filteredEvents" :key="event.id">
            <button
              class="debug-event-row"
              :class="{ selected: selectedEvent?.id === event.id, warning: event.level === 'warning' }"
              @click="selectEvent(event.id)"
            >
              <strong>{{ event.type }}</strong>
              <span>{{ event.summary }}</span>
            </button>
          </li>
        </ol>
        <p m-else class="debug-empty">No matching debug events.</p>
      </section>

      <section class="debug-section debug-event-detail">
        <h3>Event detail</h3>
        <div m-if="selectedEvent" class="debug-detail">
          <strong>{{ selectedEvent.type }}</strong>
          <span>{{ selectedEvent.summary }}</span>
          <p class="debug-event-meta" :class="{ warning: selectedEvent.level === 'warning' }">
            {{ selectedEvent.level }} / {{ selectedEvent.category }} / {{ selectedEvent.componentLabel || "no component" }}
          </p>
          <div class="debug-actions" m-if="selectedEvent.componentId">
            <button @click="selectEventComponent">Select component</button>
            <button @click="revealEventComponentRoot">Reveal component root</button>
          </div>
          <dl>
            <dt>category</dt>
            <dd>{{ selectedEvent.category }}</dd>
            <dt>component</dt>
            <dd>{{ selectedEvent.componentLabel || "none" }}</dd>
            <dt>time</dt>
            <dd>{{ selectedEvent.time }}</dd>
          </dl>
          <pre>{{ selectedEvent.payloadText }}</pre>
        </div>
        <p m-else class="debug-empty">Select an event.</p>
      </section>

      <section class="debug-section debug-snapshot">
        <div class="debug-section-title">
          <h3>Snapshot</h3>
          <div class="debug-actions">
            <button @click="toggleSnapshot">{{ snapshotOpen ? "Hide snapshot" : "Show snapshot" }}</button>
            <button @click="copySnapshot">Copy snapshot</button>
          </div>
        </div>
        <dl class="debug-snapshot-summary">
          <dt>components</dt>
          <dd>{{ snapshotSummary.components }}</dd>
          <dt>events</dt>
          <dd>{{ snapshotSummary.events }}</dd>
          <dt>filters</dt>
          <dd>{{ snapshotSummary.filters || "none" }}</dd>
        </dl>
        <p m-if="copyStatus" class="debug-filter-note">{{ copyStatus }}</p>
        <pre m-if="snapshotOpen">{{ snapshotText }}</pre>
      </section>
    </div>
  </section>
</template>

<script>
import { computed, createDebugInspector, onBeforeUnmount, ref, watch } from "mikuru/runtime";
import {
  categorizeEvent,
  collectComponentEvents,
  collectStyleEvents,
  createPanelSnapshot,
  createSnapshotSummary,
  filterVisibleComponents,
  flattenComponentTree,
  formatComponentLabel,
  isErrorEvent,
  isForegroundEvent,
  matchesEventSearch,
  stringifyPayload,
  summarizeEvent
} from "./debugPanelHelpers";

const inspector = createDebugInspector();
const allComponents = ref([]);
const components = ref([]);
const allEvents = ref([]);
const selectedId = ref(undefined);
const selectedEventId = ref(undefined);
const eventFilter = ref("all");
const componentEventFilterId = ref(undefined);
const hideBackgroundEventsAfterClear = ref(false);
const collapsedIds = ref(new Set());
const componentSearch = ref("");
const eventSearch = ref("");
const copyStatus = ref("");
const snapshotOpen = ref(false);

const selected = computed(() =>
  allComponents.value.find((component) => component.id === selectedId.value) ?? components.value[0]
);

const componentFilteredEvents = computed(() =>
  allEvents.value.filter((event) => componentEventFilterId.value === undefined || event.componentId === componentEventFilterId.value)
);

const searchedEvents = computed(() =>
  componentFilteredEvents.value.filter((event) => matchesEventSearch(event, eventSearch.value))
);

const filteredEvents = computed(() =>
  searchedEvents.value.filter((event) => eventFilter.value === "all" || event.category === eventFilter.value)
);

const selectedEvent = computed(() =>
  filteredEvents.value.find((event) => event.id === selectedEventId.value) ?? filteredEvents.value[0]
);

const snapshotText = computed(() => JSON.stringify(createCurrentPanelSnapshot(), null, 2));

const snapshotSummary = computed(() => createSnapshotSummary({
  componentSearch: componentSearch.value,
  eventSearch: eventSearch.value,
  eventFilter: eventFilter.value,
  componentEventFilterId: componentEventFilterId.value,
  allComponents: allComponents.value,
  components: components.value,
  allEvents: allEvents.value,
  filteredEvents: filteredEvents.value
}));

const componentEventFilterLabel = computed(() => {
  if (componentEventFilterId.value === undefined) {
    return "";
  }

  const component = components.value.find((item) => item.id === componentEventFilterId.value);
  return component ? `Filtered by #${component.id} ${component.name}` : `Filtered by #${componentEventFilterId.value}`;
});

const filterOptions = computed(() => [
  { id: "all", label: "All", count: componentFilteredEvents.value.length },
  { id: "component", label: "Component", count: countEvents("component") },
  { id: "style", label: "Style", count: countEvents("style") },
  { id: "async", label: "Async", count: countEvents("async") },
  { id: "hydration", label: "Hydration", count: countEvents("hydration") },
  { id: "router", label: "Router", count: countEvents("router") },
  { id: "error", label: "Error", count: countEvents("error") }
]);

function snapshot() {
  const events = inspector.getEvents();
  const stylesByComponent = collectStyleEvents(events);
  const eventsByComponent = collectComponentEvents(events);
  const flattenedComponents = flattenComponentTree(inspector.getComponentTree(), stylesByComponent, eventsByComponent, collapsedIds.value);
  allComponents.value = flattenedComponents;
  components.value = filterVisibleComponents(flattenedComponents, collapsedIds.value, componentSearch.value);

  if (hideBackgroundEventsAfterClear.value && events.some(isForegroundEvent)) {
    hideBackgroundEventsAfterClear.value = false;
  }

  const visibleEvents = hideBackgroundEventsAfterClear.value
    ? events.filter(isForegroundEvent)
    : events;

  allEvents.value = visibleEvents
    .slice(-100)
    .map((event, index) => ({
      id: `${event.timestamp}-${index}-${event.type}`,
      type: event.type,
      category: categorizeEvent(event),
      componentId: event.payload?.componentId,
      componentLabel: formatComponentLabel(event.payload?.componentId, event.payload?.component),
      level: isErrorEvent(event) ? "warning" : "info",
      time: new Date(event.timestamp).toLocaleTimeString(),
      summary: summarizeEvent(event),
      payloadText: stringifyPayload(event.payload ?? {})
    }))
    .reverse();

  if (selectedId.value && !allComponents.value.some((component) => component.id === selectedId.value)) {
    selectedId.value = undefined;
  }

  if (componentEventFilterId.value && !allComponents.value.some((component) => component.id === componentEventFilterId.value)) {
    componentEventFilterId.value = undefined;
  }

  if (selectedEventId.value && !filteredEvents.value.some((event) => event.id === selectedEventId.value)) {
    selectedEventId.value = undefined;
  }
}

function countEvents(category) {
  return searchedEvents.value.filter((event) => category === "error" ? event.level === "warning" : event.category === category).length;
}

function selectComponent(id) {
  expandAncestors(id);
  selectedId.value = id;
}

function selectEvent(id) {
  selectedEventId.value = id;
  const event = filteredEvents.value.find((item) => item.id === id);
  if (event?.componentId && allComponents.value.some((component) => component.id === event.componentId)) {
    selectComponent(event.componentId);
  }
}

function setEventFilter(filter) {
  eventFilter.value = filter;
  selectedEventId.value = undefined;
}

function showSelectedComponentEvents() {
  if (!selected.value) {
    return;
  }

  componentEventFilterId.value = selected.value.id;
  selectedEventId.value = undefined;
}

function clearComponentEventFilter() {
  componentEventFilterId.value = undefined;
  selectedEventId.value = undefined;
}

function clearComponentSearch() {
  componentSearch.value = "";
  components.value = filterVisibleComponents(allComponents.value, collapsedIds.value, componentSearch.value);
}

function clearEventSearch() {
  eventSearch.value = "";
  selectedEventId.value = undefined;
}

function createCurrentPanelSnapshot() {
  return createPanelSnapshot({
    componentSearch: componentSearch.value,
    eventSearch: eventSearch.value,
    eventFilter: eventFilter.value,
    componentEventFilterId: componentEventFilterId.value,
    allComponents: allComponents.value,
    components: components.value,
    allEvents: allEvents.value,
    searchedEvents: searchedEvents.value,
    filteredEvents: filteredEvents.value,
    selected: selected.value,
    selectedEvent: selectedEvent.value
  });
}

async function copySnapshot() {
  copyStatus.value = "";
  try {
    await navigator.clipboard.writeText(snapshotText.value);
    copyStatus.value = "Snapshot copied.";
  } catch (_error) {
    copyStatus.value = "Copy failed.";
  }
}

function toggleSnapshot() {
  snapshotOpen.value = !snapshotOpen.value;
}

function toggleComponent(id) {
  const next = new Set(collapsedIds.value);
  if (next.has(id)) {
    next.delete(id);
  } else {
    next.add(id);
  }
  collapsedIds.value = next;
  components.value = filterVisibleComponents(allComponents.value, collapsedIds.value, componentSearch.value);
}

function expandAllComponents() {
  collapsedIds.value = new Set();
  components.value = filterVisibleComponents(allComponents.value, collapsedIds.value, componentSearch.value);
}

function collapseAllComponents() {
  collapsedIds.value = new Set(allComponents.value.filter((component) => component.childCount > 0).map((component) => component.id));
  if (selected.value) {
    expandAncestors(selected.value.id);
  } else {
    components.value = filterVisibleComponents(allComponents.value, collapsedIds.value, componentSearch.value);
  }
}

function expandAncestors(id) {
  const next = new Set(collapsedIds.value);
  let parentId = allComponents.value.find((component) => component.id === id)?.parentId;
  while (parentId !== undefined) {
    next.delete(parentId);
    parentId = allComponents.value.find((component) => component.id === parentId)?.parentId;
  }
  collapsedIds.value = next;
  components.value = filterVisibleComponents(allComponents.value, collapsedIds.value, componentSearch.value);
}

function selectEventComponent() {
  if (!selectedEvent.value?.componentId) {
    return;
  }

  selectComponent(selectedEvent.value.componentId);
}

function revealEventComponentRoot() {
  selectEventComponent();
  revealSelectedRoot();
}

function revealSelectedRoot() {
  const root = selected.value?.root;
  if (!(root instanceof Element)) {
    return;
  }

  root.scrollIntoView({ block: "center", inline: "center", behavior: "instant" });
  root.dataset.mikuruDebugHighlight = "true";
  root.classList.add("debug-root-highlight");
  root.style.outline = "3px solid #e11d48";
  root.style.outlineOffset = "3px";
  window.setTimeout(() => {
    root.classList.remove("debug-root-highlight");
    delete root.dataset.mikuruDebugHighlight;
    root.style.outline = "";
    root.style.outlineOffset = "";
  }, 1200);
}

function clearEvents() {
  inspector.clearEvents();
  componentEventFilterId.value = undefined;
  eventSearch.value = "";
  hideBackgroundEventsAfterClear.value = true;
  snapshot();
}

const unsubscribe = inspector.subscribe(snapshot);
const stopComponentSearch = watch(componentSearch, () => {
  components.value = filterVisibleComponents(allComponents.value, collapsedIds.value, componentSearch.value);
});
onBeforeUnmount(unsubscribe);
onBeforeUnmount(stopComponentSearch);
snapshot();
</script>

<style scoped>
.debug-panel {
  display: grid;
  gap: 14px;
  padding: 14px;
  border: 1px solid #c7d2fe;
  border-radius: 8px;
  color: #172554;
  background: #eef2ff;
}

.debug-header,
.debug-filters,
.debug-actions,
.debug-grid {
  display: grid;
  gap: 12px;
}

.debug-header {
  grid-template-columns: 1fr auto;
  align-items: start;
}

.debug-filters {
  grid-template-columns: repeat(6, minmax(0, 1fr));
}

.debug-actions {
  grid-template-columns: repeat(auto-fit, minmax(0, max-content));
}

.debug-header h2,
.debug-header p,
.debug-section h3,
.debug-filter-note,
.debug-event-meta,
.debug-empty {
  margin: 0;
}

.debug-section-title {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 10px;
  align-items: center;
}

.debug-search {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 8px;
}

.debug-search input {
  min-width: 0;
  padding: 8px 10px;
  border: 1px solid #c7d2fe;
  border-radius: 8px;
  color: inherit;
  background: #ffffff;
}

.debug-grid {
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
}

.debug-section {
  display: grid;
  gap: 10px;
  align-content: start;
  min-width: 0;
}

.debug-events {
  grid-column: 1 / -1;
}

.debug-event-detail {
  grid-column: 1 / -1;
}

.debug-snapshot {
  grid-column: 1 / -1;
}

.debug-list,
.debug-event-list {
  display: grid;
  gap: 8px;
  max-height: 320px;
  overflow: auto;
  padding: 0;
  margin: 0;
  list-style: none;
  scrollbar-gutter: stable;
}

.debug-component-item {
  display: grid;
  grid-template-columns: 26px minmax(0, 1fr);
  gap: 6px;
  align-items: stretch;
}

.debug-tree-toggle,
.debug-tree-spacer {
  width: 26px;
  min-height: 72px;
}

.debug-tree-toggle {
  padding: 0;
  border: 1px solid #c7d2fe;
  border-radius: 8px;
  color: #3730a3;
  background: #ffffff;
}

.debug-component-row {
  display: grid;
  gap: 4px;
  width: 100%;
  min-height: 72px;
  padding: 10px;
  text-align: left;
  border: 1px solid #c7d2fe;
  border-radius: 8px;
  color: inherit;
  background: #ffffff;
}

.debug-component-row.selected,
.debug-event-row.selected,
.debug-filters button.active {
  border-color: #4f46e5;
  box-shadow: inset 3px 0 0 #4f46e5;
}

.debug-component-row.selected,
.debug-event-row.selected {
  color: #1e1b4b;
  background: #e0e7ff;
}

.debug-component-row span,
.debug-event-list span,
.debug-detail span,
.debug-empty {
  color: #475569;
}

.debug-detail {
  display: grid;
  gap: 8px;
  align-content: start;
  min-width: 0;
  min-height: 280px;
  padding: 10px;
  border: 1px solid #c7d2fe;
  border-radius: 8px;
  background: #ffffff;
}

.debug-detail dl {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 6px 10px;
  margin: 0;
}

.debug-detail dt {
  font-weight: 700;
}

.debug-detail dd {
  margin: 0;
  min-width: 0;
  overflow-wrap: anywhere;
}

.debug-detail pre {
  overflow: auto;
  max-height: 180px;
  padding: 8px;
  margin: 0;
  border-radius: 6px;
  color: #0f172a;
  background: #f8fafc;
}

.debug-event-meta {
  padding: 7px 9px;
  border: 1px solid #c7d2fe;
  border-radius: 8px;
  color: #1e3a8a;
  background: #eff6ff;
}

.debug-event-meta.warning {
  border-color: #fb923c;
  color: #7c2d12;
  background: #fff7ed;
}

.debug-snapshot-summary {
  display: grid;
  grid-template-columns: repeat(3, auto minmax(0, 1fr));
  gap: 6px 8px;
  align-items: center;
  padding: 10px;
  margin: 0;
  border: 1px solid #c7d2fe;
  border-radius: 8px;
  background: #ffffff;
}

.debug-snapshot-summary dt {
  font-weight: 700;
}

.debug-snapshot-summary dd {
  margin: 0;
  min-width: 0;
  overflow-wrap: anywhere;
}

.debug-snapshot pre {
  overflow: auto;
  max-height: 260px;
  padding: 10px;
  margin: 0;
  border: 1px solid #c7d2fe;
  border-radius: 8px;
  color: #0f172a;
  background: #ffffff;
}

.debug-event-row {
  display: flex;
  align-items: start;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
  min-height: 48px;
  padding: 8px 10px;
  text-align: left;
  border: 1px solid #c7d2fe;
  border-radius: 8px;
  color: inherit;
  background: #ffffff;
}

.debug-event-row.warning {
  border-color: #fb923c;
  color: #7c2d12;
  background: #fff7ed;
}

@media (max-width: 720px) {
  .debug-header,
  .debug-filters,
  .debug-actions,
  .debug-section-title,
  .debug-search,
  .debug-grid {
    grid-template-columns: 1fr;
  }

  .debug-list,
  .debug-event-list {
    max-height: 260px;
  }

  .debug-snapshot-summary {
    grid-template-columns: auto minmax(0, 1fr);
  }

  .debug-event-row {
    display: grid;
  }
}
</style>
