<template>
  <main class="dogfood">
    <header>
      <h1>Dogfood Notes</h1>
      <div class="header-actions">
        <button @click="openSummary">Open summary</button>
        <button @click="seedMore">Seed more notes</button>
      </div>
    </header>

    <TextField label="Search" m-model="search" />

    <DebugPanel />

    <RouterLab />

    <KeepAliveLab />

    <ModelLab />

    <section class="component-lab" aria-label="Component lab">
      <div class="component-lab-header">
        <div>
          <h2>Component lab</h2>
          <p>Popover, AlertDialog, Table, Pagination, and DatePicker primitives.</p>
        </div>
        <MikuruPopover
          label="Release notes"
          title="Mikuru components"
          body="New primitives compose into forms, dashboards, and workflow screens."
          side="left"
        />
      </div>

      <div class="component-grid">
        <div class="component-panel">
          <h3>AlertDialog</h3>
          <button class="danger-action" @click="openAlertDialog">Archive selected note</button>
          <p>{{ alertStatus }}</p>
        </div>

        <div class="component-panel">
          <h3>DatePicker</h3>
          <MikuruDatePicker
            label="Review date"
            :modelValue="reviewDate"
            locale="en-US"
            @change="setReviewDate"
          />
          <p>Selected: {{ reviewDate }}</p>
        </div>
      </div>

      <MikuruTable
        caption="Release readiness"
        :columns="tableColumns"
        :rows="pagedRows"
        rowKey="id"
        @sort="handleTableSort"
        @row-click="handleTableRowClick"
      />

      <div class="table-footer">
        <span>{{ tableStatus }}</span>
        <MikuruPagination
          :page="tablePage"
          :total="tableTotalPages"
          @change="setTablePage"
        />
      </div>
    </section>

    <section class="navigation-lab" aria-label="Navigation and action components lab">
      <div class="lab-heading">
        <div>
          <h2>Navigation lab</h2>
          <p>Drawer, Breadcrumb, Badge, EmptyState, Skeleton, and CommandPalette primitives.</p>
        </div>
        <div class="lab-actions">
          <button @click="openDrawer">Open drawer</button>
          <button @click="openCommandPalette">Open command palette</button>
        </div>
      </div>

      <MikuruBreadcrumb :items="breadcrumbItems" @select="handleBreadcrumbSelect" />

      <div class="badge-row">
        <MikuruBadge label="Ready" tone="success" />
        <MikuruBadge label="Review" tone="warning" />
        <MikuruBadge label="Blocked" tone="danger" variant="outline" />
        <span>{{ navigationStatus }}</span>
      </div>

      <div class="component-grid">
        <MikuruEmptyState
          title="No filtered notes"
          description="EmptyState keeps quiet screens intentional."
          actionLabel="Seed note"
          @action="seedMore"
        />
        <div class="component-panel">
          <h3>Skeleton</h3>
          <MikuruSkeleton :lines="4" height="14px" />
        </div>
      </div>
    </section>

    <section class="form-lab" aria-label="Form components lab">
      <div>
        <h2>Form lab</h2>
        <p>Switch, RadioGroup, and FileUpload components.</p>
      </div>
      <div class="component-grid">
        <div class="component-panel">
          <MikuruSwitch
            label="Enable release checklist"
            :modelValue="releaseChecklistEnabled"
            help="Switch emits update:modelValue and change."
            @change="setReleaseChecklistEnabled"
          />
          <MikuruRadioGroup
            label="Release channel"
            :modelValue="releaseChannel"
            :options="releaseChannelOptions"
            help="RadioGroup supports descriptions and disabled options."
            @change="setReleaseChannel"
          />
        </div>
        <div class="component-panel">
          <MikuruFileUpload
            label="Attach release files"
            multiple
            help="Drop files or use the native file picker."
            @change="setUploadedFiles"
            @clear="clearUploadedFiles"
          />
          <p>{{ uploadStatus }}</p>
        </div>
      </div>
    </section>

    <section class="utility-lab" aria-label="Search and data input components lab">
      <div class="lab-heading">
        <div>
          <h2>Search and data lab</h2>
          <p>SearchInput, SegmentedControl, Chip, TagInput, RangeSlider, ColorPicker, TimePicker, Calendar, DataList, and TreeView primitives.</p>
        </div>
        <MikuruChip label="Utility batch" tone="success" />
      </div>

      <div class="component-grid">
        <div class="component-panel">
          <MikuruSearchInput
            label="Component search"
            :modelValue="utilitySearch"
            placeholder="Search components"
            @input="setUtilitySearch"
            @submit="submitUtilitySearch"
            @clear="clearUtilitySearch"
          />
          <MikuruSegmentedControl
            label="Display mode"
            :modelValue="segmentMode"
            :options="segmentOptions"
            @change="setSegmentMode"
          />
          <MikuruTagInput
            label="Release tags"
            :modelValue="tagValues"
            help="Press Enter or comma to add tags."
            @change="setTagValues"
          />
          <p>{{ utilityStatus }}</p>
        </div>

        <div class="component-panel">
          <MikuruRangeSlider
            label="Score range"
            :minValue="rangeMin"
            :maxValue="rangeMax"
            :min="0"
            :max="100"
            :step="5"
            @change="setRangeValue"
          />
          <MikuruColorPicker label="Accent color" :modelValue="themeColor" @change="setThemeColor" />
          <MikuruTimePicker label="Review time" :modelValue="eventTime" @change="setEventTime" />
        </div>
      </div>

      <div class="component-grid">
        <MikuruCalendar :modelValue="calendarDate" locale="en-US" @change="setCalendarDate" />
        <div class="component-panel">
          <MikuruDataList label="Release tasks" :items="dataListItems" />
          <MikuruTreeView label="Component tree" :nodes="treeNodes" @select="handleTreeSelect" />
        </div>
      </div>
    </section>

    <section class="foundation-lab" aria-label="Form and data foundation components lab">
      <div class="lab-heading">
        <div>
          <h2>Form and data foundation lab</h2>
          <p>Form, Field, FormMessage, PasswordInput, NumberInput, InputOtp, ComboboxMulti, FilterBar, DataToolbar, and VirtualList primitives.</p>
        </div>
        <MikuruFormMessage tone="success" :message="foundationStatus" />
      </div>

      <MikuruForm
        title="Release form"
        description="Composable form shell with reusable field rows."
        @submit="submitFoundationForm"
        @reset="resetFoundationForm"
      >
        <div class="component-grid">
          <div class="component-panel">
            <MikuruField label="Password" help="Toggle visibility and strength text." required>
              <MikuruPasswordInput
                label="Account password"
                :modelValue="foundationPassword"
                placeholder="Enter password"
                @input="setFoundationPassword"
              />
            </MikuruField>
            <MikuruField label="Quantity" help="Stepper-based number input.">
              <MikuruNumberInput
                label="Package count"
                :modelValue="foundationCount"
                :min="1"
                :max="9"
                @change="setFoundationCount"
              />
            </MikuruField>
            <MikuruInputOtp
              label="Release OTP"
              :modelValue="foundationOtp"
              :length="6"
              @input="setFoundationOtp"
              @complete="completeFoundationOtp"
            />
          </div>

          <div class="component-panel">
            <MikuruComboboxMulti
              label="Release owners"
              :modelValue="foundationOwners"
              :options="ownerOptions"
              @change="setFoundationOwners"
            />
            <MikuruFilterBar
              :search="foundationSearch"
              :filters="foundationFilters"
              :activeFilter="foundationFilter"
              searchPlaceholder="Filter releases"
              @search="setFoundationSearch"
              @filter="setFoundationFilter"
              @clear="clearFoundationSearch"
            />
          </div>
        </div>

        <div class="foundation-actions">
          <button type="submit">Submit foundation form</button>
          <button type="reset">Reset</button>
        </div>
      </MikuruForm>

      <MikuruDataToolbar
        title="Virtual release list"
        description="Toolbar actions and a virtualized list for large data."
        :actions="toolbarActions"
        @action="handleToolbarAction"
      />
      <MikuruVirtualList :items="virtualRows" :height="220" :itemHeight="54" />
    </section>

    <section class="identity-lab" aria-label="Identity and workflow components lab">
      <div class="lab-heading">
        <div>
          <h2>Identity and workflow lab</h2>
          <p>Avatar, ContextMenu, Stepper, Slider, Rating, Timeline, StatCard, and Kbd primitives.</p>
        </div>
        <div class="kbd-row">
          <MikuruKbd label="Ctrl" />
          <MikuruKbd label="K" />
        </div>
      </div>

      <div class="stat-grid">
        <MikuruStatCard label="Components" value="46" detail="Package exported primitives" tone="info" />
        <MikuruStatCard label="Readiness" :value="`${ratingValue}/5`" detail="Interactive rating state" tone="success" />
        <MikuruStatCard label="Coverage" :value="`${sliderValue}%`" detail="Slider-controlled value" tone="warning" />
      </div>

      <div class="component-grid">
        <div class="component-panel">
          <h3>Avatars</h3>
          <div class="avatar-row">
            <MikuruAvatar name="Mikuru User" size="lg" />
            <MikuruAvatarGroup :avatars="avatarItems" :max="3" />
          </div>
          <MikuruContextMenu :items="contextMenuItems" @select="handleContextMenuSelect">
            <button class="context-target" type="button">Right click actions</button>
          </MikuruContextMenu>
          <p>{{ workflowStatus }}</p>
        </div>

        <div class="component-panel">
          <h3>Workflow controls</h3>
          <MikuruStepper :steps="workflowSteps" :current="currentStep" @change="setCurrentStep" />
          <MikuruSlider
            label="Release confidence"
            :modelValue="sliderValue"
            :min="0"
            :max="100"
            :step="5"
            @change="setSliderValue"
          />
          <MikuruRating :modelValue="ratingValue" @change="setRatingValue" />
        </div>
      </div>

      <MikuruTimeline :items="timelineItems" />
    </section>

    <section class="editor-lab" aria-label="Editor lab">
      <div>
        <h2>Editor lab</h2>
        <p>Markdown and WYSIWYG editors with model updates.</p>
      </div>
      <div class="editor-grid">
        <MikuruMarkdownEditor
          label="Markdown brief"
          :modelValue="markdownDraft"
          help="Markdown supports headings, lists, quotes, emphasis, code, and links."
          @change="setMarkdownDraft"
        />
        <MikuruWysiwygEditor
          label="WYSIWYG brief"
          :modelValue="wysiwygDraft"
          help="Toolbar changes emit sanitized HTML."
          @change="setWysiwygDraft"
          @input="setWysiwygDraft"
        />
      </div>
      <p class="editor-status">Markdown length: {{ markdownDraft.length }} · HTML length: {{ wysiwygDraft.length }}</p>
    </section>

    <MediaLab />

    <TransitionGroupLab />

    <AsyncBoundary :loading="LoadingStats" :fallback="AsyncFallback">
      <AsyncStats
        :total="notes.length"
        :active="activeCount"
        :archived="archivedCount"
      />
    </AsyncBoundary>

    <section class="async-lab" aria-label="AsyncBoundary lab">
      <div>
        <h2>AsyncBoundary lab</h2>
        <p>Shared async fallback retries the whole boundary child.</p>
      </div>
      <AsyncBoundary :loading="LoadingStats" :fallback="AsyncFallback">
        <FlakyAsyncPanel />
      </AsyncBoundary>
    </section>

    <section class="error-lab" aria-label="ErrorBoundary lab">
      <div>
        <h2>ErrorBoundary lab</h2>
        <p>Fallback props expose phase, filename, and reset controls.</p>
      </div>
      <ErrorBoundary :fallback="ErrorFallback" :reset-key="boundaryVersion">
        <button class="danger-action" @click="triggerBoundaryError">Trigger boundary error</button>
      </ErrorBoundary>
      <button @click="resetBoundaryKey">Reset boundary key</button>
    </section>

    <nav class="filters">
      <button @click="showAll">All</button>
      <button @click="showActive">Active</button>
      <button @click="showArchived">Archived</button>
    </nav>

    <section class="notes">
      <NoteCard
        m-for="note in filteredNotes"
        :key="note.id"
        m-memo="[note.id, note.title, note.body, note.archived]"
        :note="note"
        @archive="archiveNote"
        @restore="restoreNote"
      >
        <small>{{ note.statusLabel }}</small>
      </NoteCard>
    </section>

    <Teleport to="#modal-root">
      <section m-if="summaryOpen" class="summary-modal" role="dialog">
        <div class="summary-card">
          <strong>Teleported summary</strong>
          <p>{{ activeCount }} active notes and {{ archivedCount }} archived notes.</p>
          <button @click="closeSummary">Close summary</button>
        </div>
      </section>
    </Teleport>

    <MikuruAlertDialog
      :open="alertOpen"
      title="Archive selected note?"
      description="This checks the AlertDialog confirm and cancel events."
      body="The dogfood data will update only in memory."
      confirmLabel="Archive"
      cancelLabel="Keep note"
      @confirm="confirmAlertDialog"
      @cancel="cancelAlertDialog"
      @close="closeAlertDialog"
    />

    <MikuruDrawer
      :open="drawerOpen"
      title="Release drawer"
      side="right"
      closeLabel="Done"
      @close="closeDrawer"
    >
      <p>Drawer content can hold settings, details, filters, or secondary workflows.</p>
      <MikuruBadge label="Dogfood" tone="info" />
    </MikuruDrawer>

    <MikuruCommandPalette
      :open="commandPaletteOpen"
      :commands="commandPaletteCommands"
      placeholder="Search dogfood actions..."
      @close="closeCommandPalette"
      @select="handleCommandSelect"
    />
  </main>
</template>

<script>
import { computed, defineAsyncComponent, ref } from "mikuru";
import MikuruAlertDialog from "../../components/MikuruAlertDialog.mikuru";
import MikuruAvatar from "../../components/MikuruAvatar.mikuru";
import MikuruAvatarGroup from "../../components/MikuruAvatarGroup.mikuru";
import MikuruBadge from "../../components/MikuruBadge.mikuru";
import MikuruBreadcrumb from "../../components/MikuruBreadcrumb.mikuru";
import MikuruCalendar from "../../components/MikuruCalendar.mikuru";
import MikuruChip from "../../components/MikuruChip.mikuru";
import MikuruColorPicker from "../../components/MikuruColorPicker.mikuru";
import MikuruCommandPalette from "../../components/MikuruCommandPalette.mikuru";
import MikuruContextMenu from "../../components/MikuruContextMenu.mikuru";
import MikuruDataList from "../../components/MikuruDataList.mikuru";
import MikuruDatePicker from "../../components/MikuruDatePicker.mikuru";
import MikuruDrawer from "../../components/MikuruDrawer.mikuru";
import MikuruEmptyState from "../../components/MikuruEmptyState.mikuru";
import MikuruFileUpload from "../../components/MikuruFileUpload.mikuru";
import MikuruComboboxMulti from "../../components/MikuruComboboxMulti.mikuru";
import MikuruDataToolbar from "../../components/MikuruDataToolbar.mikuru";
import MikuruField from "../../components/MikuruField.mikuru";
import MikuruFilterBar from "../../components/MikuruFilterBar.mikuru";
import MikuruForm from "../../components/MikuruForm.mikuru";
import MikuruFormMessage from "../../components/MikuruFormMessage.mikuru";
import MikuruInputOtp from "../../components/MikuruInputOtp.mikuru";
import MikuruKbd from "../../components/MikuruKbd.mikuru";
import MikuruMarkdownEditor from "../../components/MikuruMarkdownEditor.mikuru";
import MikuruNumberInput from "../../components/MikuruNumberInput.mikuru";
import MikuruPagination from "../../components/MikuruPagination.mikuru";
import MikuruPasswordInput from "../../components/MikuruPasswordInput.mikuru";
import MikuruPopover from "../../components/MikuruPopover.mikuru";
import MikuruRadioGroup from "../../components/MikuruRadioGroup.mikuru";
import MikuruRating from "../../components/MikuruRating.mikuru";
import MikuruRangeSlider from "../../components/MikuruRangeSlider.mikuru";
import MikuruSearchInput from "../../components/MikuruSearchInput.mikuru";
import MikuruSegmentedControl from "../../components/MikuruSegmentedControl.mikuru";
import MikuruSkeleton from "../../components/MikuruSkeleton.mikuru";
import MikuruSlider from "../../components/MikuruSlider.mikuru";
import MikuruStatCard from "../../components/MikuruStatCard.mikuru";
import MikuruStepper from "../../components/MikuruStepper.mikuru";
import MikuruSwitch from "../../components/MikuruSwitch.mikuru";
import MikuruTable from "../../components/MikuruTable.mikuru";
import MikuruTagInput from "../../components/MikuruTagInput.mikuru";
import MikuruTimePicker from "../../components/MikuruTimePicker.mikuru";
import MikuruTimeline from "../../components/MikuruTimeline.mikuru";
import MikuruTreeView from "../../components/MikuruTreeView.mikuru";
import MikuruVirtualList from "../../components/MikuruVirtualList.mikuru";
import MikuruWysiwygEditor from "../../components/MikuruWysiwygEditor.mikuru";
import DebugPanel from "./DebugPanel.mikuru";
import KeepAliveLab from "./KeepAliveLab.mikuru";
import MediaLab from "./MediaLab.mikuru";
import ModelLab from "./ModelLab.mikuru";
import RouterLab from "./RouterLab.mikuru";
import TransitionGroupLab from "./TransitionGroupLab.mikuru";
import TextField from "./TextField.mikuru";
import NoteCard from "./NoteCard.mikuru";

const LoadingStats = {
  mount(target) {
    const panel = document.createElement("aside");
    panel.className = "stats-loading";
    panel.textContent = "Loading note stats...";
    target.appendChild(panel);
    return {
      element: panel,
      unmount() {
        panel.remove();
      }
    };
  }
};

const AsyncStats = defineAsyncComponent({
  loader: () => new Promise((resolve) => {
    setTimeout(() => {
      import("./StatsPanel.mikuru").then(resolve);
    }, 300);
  })
});

let flakyAttempts = 0;

const FlakyLoadedPanel = {
  mount(target) {
    const panel = document.createElement("aside");
    panel.className = "stats-panel async-success";
    panel.textContent = "AsyncBoundary retry recovered";
    target.appendChild(panel);
    return {
      element: panel,
      unmount() {
        panel.remove();
      }
    };
  }
};

const FlakyAsyncPanel = defineAsyncComponent({
  loader: () => new Promise((resolve, reject) => {
    setTimeout(() => {
      flakyAttempts += 1;
      if (flakyAttempts === 1) {
        reject(new Error("Dogfood async failure"));
        return;
      }
      resolve(FlakyLoadedPanel);
    }, 100);
  })
});

const search = ref("");
const filter = ref("all");
const summaryOpen = ref(false);
const boundaryVersion = ref(0);
const alertOpen = ref(false);
const alertStatus = ref("No dialog action yet.");
const drawerOpen = ref(false);
const commandPaletteOpen = ref(false);
const navigationStatus = ref("Breadcrumb and command actions appear here.");
const releaseChecklistEnabled = ref(true);
const releaseChannel = ref("beta");
const uploadStatus = ref("No files selected.");
const workflowStatus = ref("Context menu and workflow actions appear here.");
const currentStep = ref("build");
const sliderValue = ref(75);
const ratingValue = ref(4);
const utilitySearch = ref("");
const utilityStatus = ref("Search and data actions appear here.");
const segmentMode = ref("list");
const tagValues = ref(["ui", "dogfood"]);
const rangeMin = ref(20);
const rangeMax = ref(80);
const themeColor = ref("#2563eb");
const eventTime = ref("10:30");
const calendarDate = ref("2026-05-18");
const foundationStatus = ref("Foundation components are ready.");
const foundationPassword = ref("mikuru123");
const foundationCount = ref(2);
const foundationOtp = ref("");
const foundationOwners = ref(["ui", "docs"]);
const foundationSearch = ref("");
const foundationFilter = ref("all");
const reviewDate = ref("2026-05-17");
const markdownDraft = ref("# Release brief\n\n## Markdown coverage\n\n- Ship editor components\n+ Support plus lists\n1. Ordered item\n2. Another item\n- [x] Task done\n- [ ] Task open\n\n> Dogfood should stay honest.\n>> Nested quote\n\n| Syntax | Status |\n|---|---:|\n| Table | Ready |\n| Emoji :rocket: | Ready |\n\n**Bold** _italic_ ~~deleted~~ and `inline code`.\n\n$E = mc^2$\n\n```js\nconst ready = true;\n```\n\n---\n\n![Sample](https://interactive-examples.mdn.mozilla.net/media/cc0-images/grapefruit-slice-332-332.jpg =120x)\n\n<br>\n<b>Inline HTML</b>");
const wysiwygDraft = ref("<h2>Release brief</h2><p><strong>WYSIWYG</strong> output is sanitized HTML.</p>");
const tablePage = ref(1);
const tableStatus = ref("No table row selected.");
const tableColumns = [
  { key: "name", label: "Item", sortable: true },
  { key: "owner", label: "Owner", sortable: true },
  { key: "status", label: "Status" },
  { key: "score", label: "Score", sortable: true, align: "right", width: "86px" }
];
const tableRows = ref([
  { id: "popover", name: "Popover", owner: "UI", status: "Ready", score: 94 },
  { id: "alert", name: "AlertDialog", owner: "UI", status: "Ready", score: 91 },
  { id: "table", name: "Table", owner: "Data", status: "Review", score: 88 },
  { id: "pagination", name: "Pagination", owner: "Data", status: "Ready", score: 90 },
  { id: "date", name: "DatePicker", owner: "Forms", status: "Review", score: 86 }
]);
const breadcrumbItems = [
  { label: "Components", value: "components" },
  { label: "Dogfood", value: "dogfood" },
  { label: "Release lab", value: "release", current: true }
];
const releaseChannelOptions = [
  { label: "Stable", value: "stable", description: "Only tested components." },
  { label: "Beta", value: "beta", description: "Includes dogfood primitives." },
  { label: "Nightly", value: "nightly", description: "Disabled example.", disabled: true }
];
const commandPaletteCommands = [
  { id: "seed", label: "Seed note", description: "Add one extra dogfood note.", keywords: "notes add" },
  { id: "drawer", label: "Open drawer", description: "Show the Drawer component.", keywords: "panel settings" },
  { id: "archive", label: "Open archive dialog", description: "Show the AlertDialog component.", keywords: "modal confirm" }
];
const avatarItems = [
  { id: "mk", name: "Mikuru Kit" },
  { id: "ui", name: "UI Team" },
  { id: "qa", name: "QA Lead" },
  { id: "docs", name: "Docs Owner" }
];
const contextMenuItems = [
  { id: "copy", label: "Copy component name", shortcut: "Ctrl+C" },
  { id: "pin", label: "Pin to lab" },
  { id: "disabled", label: "Disabled item", disabled: true }
];
const workflowSteps = [
  { label: "Design", value: "design", description: "API shape", completed: true },
  { label: "Build", value: "build", description: "Component code" },
  { label: "Verify", value: "verify", description: "Dogfood checks" }
];
const timelineItems = [
  { id: "api", title: "API drafted", time: "09:00", description: "Props and events are aligned.", tone: "success" },
  { id: "dogfood", title: "Dogfood wired", time: "10:15", description: "Interactions run in the browser.", tone: "info" },
  { id: "release", title: "Release prep", time: "Next", description: "Package checks before publishing.", tone: "warning" }
];
const segmentOptions = [
  { label: "List", value: "list" },
  { label: "Grid", value: "grid" },
  { label: "Compact", value: "compact" }
];
const dataListItems = [
  { id: "exports", title: "Export components", description: "Expose package entrypoints.", meta: "Ready" },
  { id: "types", title: "Ship types", description: "Typed component props.", meta: "Ready" },
  { id: "dogfood", title: "Dogfood examples", description: "Interactive coverage.", meta: "Review" }
];
const treeNodes = [
  {
    id: "inputs",
    label: "Inputs",
    children: [
      { id: "search", label: "SearchInput" },
      { id: "tags", label: "TagInput" }
    ]
  },
  {
    id: "data",
    label: "Data",
    children: [
      { id: "list", label: "DataList" },
      { id: "tree", label: "TreeView" }
    ]
  }
];
const ownerOptions = [
  { label: "UI Team", value: "ui" },
  { label: "Docs Owner", value: "docs" },
  { label: "QA Lead", value: "qa" },
  { label: "Release Manager", value: "release" }
];
const foundationFilters = [
  { label: "All", value: "all" },
  { label: "Ready", value: "ready" },
  { label: "Review", value: "review" }
];
const toolbarActions = [
  { id: "refresh", label: "Refresh" },
  { id: "export", label: "Export" }
];
const virtualRows = Array.from({ length: 80 }, (_, index) => ({
  id: `virtual-${index + 1}`,
  title: `Virtual row ${index + 1}`,
  description: index % 2 === 0 ? "Ready for release" : "Needs review"
}));
const notes = ref([
  {
    id: "parser",
    title: "Parser limits should stay loud",
    body: "Compile errors should include a focused code frame.",
    owner: "Compiler",
    archived: true,
    statusLabel: "Archived"
  },
  {
    id: "scoped",
    title: "Scoped CSS works for simple selectors",
    body: "Basic selector rewriting keeps component styles local.",
    owner: "Runtime",
    archived: false,
    statusLabel: "Active"
  },
  {
    id: "cleanup",
    title: "Unmount cleanup under filters",
    body: "Effects and event listeners should be released predictably.",
    owner: "Runtime",
    archived: false,
    statusLabel: "Active"
  }
]);

const ErrorFallback = {
  mount(target, props) {
    const panel = document.createElement("section");
    panel.className = "error-fallback";
    panel.setAttribute("role", "alert");

    const title = document.createElement("strong");
    title.textContent = "Boundary caught an error";

    const message = document.createElement("p");
    const errorMessage = props.error instanceof Error ? props.error.message : String(props.error);
    message.textContent = `${props.errorInfo?.phase ?? "runtime"} in ${props.errorInfo?.filename ?? "unknown"}: ${errorMessage}`;

    const reset = document.createElement("button");
    reset.textContent = "Reset boundary";
    reset.addEventListener("click", () => props.reset());

    panel.append(title, message, reset);
    target.appendChild(panel);
    return {
      element: panel,
      unmount() {
        panel.remove();
      }
    };
  }
};

const AsyncFallback = {
  mount(target, props) {
    const panel = document.createElement("section");
    panel.className = "async-fallback";
    panel.setAttribute("role", "alert");

    const title = document.createElement("strong");
    title.textContent = "AsyncBoundary caught an error";

    const message = document.createElement("p");
    const errorMessage = props.error instanceof Error ? props.error.message : String(props.error);
    message.textContent = `${props.errorInfo?.phase ?? "async-loader"} with ${props.pending} pending: ${errorMessage}`;

    const retry = document.createElement("button");
    retry.textContent = "Retry async boundary";
    retry.addEventListener("click", () => props.retry());

    panel.append(title, message, retry);
    target.appendChild(panel);
    return {
      element: panel,
      unmount() {
        panel.remove();
      }
    };
  }
};

const filteredNotes = computed(() => {
  const query = search.value.trim().toLowerCase();
  return notes.value.filter((note) => {
    const matchesFilter =
      filter.value === "all" ||
      (filter.value === "archived" ? note.archived : !note.archived);
    const matchesSearch =
      !query ||
      note.title.toLowerCase().includes(query) ||
      note.body.toLowerCase().includes(query) ||
      note.owner.toLowerCase().includes(query);
    return matchesFilter && matchesSearch;
  });
});

const activeCount = computed(() => notes.value.filter((note) => !note.archived).length);
const archivedCount = computed(() => notes.value.filter((note) => note.archived).length);
const tableTotalPages = computed(() => Math.max(1, Math.ceil(tableRows.value.length / 3)));
const pagedRows = computed(() => {
  const start = (tablePage.value - 1) * 3;
  return tableRows.value.slice(start, start + 3);
});

function setArchived(id, archived) {
  notes.value = notes.value.map((note) =>
    note.id === id
      ? {
          ...note,
          archived,
          statusLabel: archived ? "Archived" : "Active"
        }
      : note
  );
}

function archiveNote(id) {
  setArchived(id, true);
}

function restoreNote(id) {
  setArchived(id, false);
}

function seedMore() {
  if (notes.value.some((note) => note.id === "keyed")) {
    return;
  }

  notes.value = [
    ...notes.value,
    {
      id: "keyed",
      title: "Keyed lists keep card identity",
      body: "The generated keyed range should reuse card instances.",
      owner: "Compiler",
      archived: false,
      statusLabel: "Active"
    }
  ];
}

function openSummary() {
  summaryOpen.value = true;
}

function closeSummary() {
  summaryOpen.value = false;
}

function triggerBoundaryError() {
  throw new Error("Dogfood boundary failure");
}

function resetBoundaryKey() {
  boundaryVersion.value += 1;
}

function openAlertDialog() {
  alertOpen.value = true;
}

function closeAlertDialog() {
  alertOpen.value = false;
}

function openDrawer() {
  drawerOpen.value = true;
}

function closeDrawer() {
  drawerOpen.value = false;
}

function openCommandPalette() {
  commandPaletteOpen.value = true;
}

function closeCommandPalette() {
  commandPaletteOpen.value = false;
}

function confirmAlertDialog() {
  alertStatus.value = "Confirmed archive action.";
}

function cancelAlertDialog() {
  alertStatus.value = "Canceled archive action.";
}

function setReviewDate(value) {
  reviewDate.value = value;
}

function setMarkdownDraft(value) {
  markdownDraft.value = value;
}

function setWysiwygDraft(value) {
  wysiwygDraft.value = value;
}

function setReleaseChecklistEnabled(value) {
  releaseChecklistEnabled.value = value;
}

function setReleaseChannel(value) {
  releaseChannel.value = value;
}

function setUploadedFiles(files) {
  uploadStatus.value = files.length ? `${files.length} file(s) selected.` : "No files selected.";
}

function clearUploadedFiles() {
  uploadStatus.value = "No files selected.";
}

function handleContextMenuSelect(item) {
  workflowStatus.value = `Context action selected: ${item.label}.`;
}

function setCurrentStep(value) {
  currentStep.value = value;
  workflowStatus.value = `Stepper moved to ${value}.`;
}

function setSliderValue(value) {
  sliderValue.value = value;
}

function setRatingValue(value) {
  ratingValue.value = value;
}

function setUtilitySearch(value) {
  utilitySearch.value = value;
}

function submitUtilitySearch(value) {
  utilityStatus.value = `Search submitted: ${value || "empty"}.`;
}

function clearUtilitySearch() {
  utilitySearch.value = "";
  utilityStatus.value = "Search cleared.";
}

function setSegmentMode(value) {
  segmentMode.value = value;
  utilityStatus.value = `Segment selected: ${value}.`;
}

function setTagValues(values) {
  tagValues.value = values;
  utilityStatus.value = `${values.length} tag(s) selected.`;
}

function setRangeValue(range) {
  rangeMin.value = range.min;
  rangeMax.value = range.max;
  utilityStatus.value = `Range selected: ${range.min}-${range.max}.`;
}

function setThemeColor(value) {
  themeColor.value = value;
}

function setEventTime(value) {
  eventTime.value = value;
}

function setCalendarDate(value) {
  calendarDate.value = value;
  utilityStatus.value = `Calendar selected: ${value}.`;
}

function handleTreeSelect(node) {
  utilityStatus.value = `Tree node selected: ${node.label}.`;
}

function setFoundationPassword(value) {
  foundationPassword.value = value;
}

function setFoundationCount(value) {
  foundationCount.value = value;
}

function setFoundationOtp(value) {
  foundationOtp.value = value;
}

function completeFoundationOtp(value) {
  foundationStatus.value = `OTP complete: ${value}.`;
}

function setFoundationOwners(values) {
  foundationOwners.value = values;
  foundationStatus.value = `${values.length} owner(s) selected.`;
}

function setFoundationSearch(value) {
  foundationSearch.value = value;
  foundationStatus.value = `Filter search: ${value || "empty"}.`;
}

function clearFoundationSearch() {
  foundationSearch.value = "";
  foundationStatus.value = "Filter search cleared.";
}

function setFoundationFilter(value) {
  foundationFilter.value = value;
  foundationStatus.value = `Filter selected: ${value}.`;
}

function submitFoundationForm() {
  foundationStatus.value = `Submitted ${foundationOwners.value.length} owner(s), count ${foundationCount.value}.`;
}

function resetFoundationForm() {
  foundationStatus.value = "Foundation form reset.";
}

function handleToolbarAction(action) {
  foundationStatus.value = `Toolbar action: ${action.label}.`;
}

function setTablePage(page) {
  tablePage.value = page;
}

function handleTableSort(sort) {
  tableStatus.value = `Sorted by ${sort.key} ${sort.direction}.`;
}

function handleTableRowClick(row) {
  tableStatus.value = `Selected ${row.name}.`;
}

function handleBreadcrumbSelect(item) {
  navigationStatus.value = `Selected breadcrumb: ${item.label}.`;
}

function handleCommandSelect(command) {
  navigationStatus.value = `Command selected: ${command.label}.`;
  if (command.id === "seed") seedMore();
  if (command.id === "drawer") openDrawer();
  if (command.id === "archive") openAlertDialog();
}

function showAll() {
  filter.value = "all";
}

function showActive() {
  filter.value = "active";
}

function showArchived() {
  filter.value = "archived";
}
</script>

