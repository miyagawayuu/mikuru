  border-color: #fde68a;
  color: #713f12;
  background: #fffbeb;
}

.identity-lab {
  border-color: #fecdd3;
  color: #881337;
  background: #fff1f2;
}

.foundation-lab {
  border-color: #c7d2fe;
  color: #312e81;
  background: #eef2ff;
}

.foundation-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.lab-heading,
.lab-actions,
.badge-row,
.avatar-row,
.kbd-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

.lab-actions,
.badge-row,
.avatar-row,
.kbd-row {
  justify-content: flex-start;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.context-target {
  justify-self: start;
}

.badge-row > span:last-child {
  color: #0f172a;
