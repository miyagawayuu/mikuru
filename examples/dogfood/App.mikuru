<template>
  <main class="dogfood">
    <header>
      <h1>Dogfood Notes</h1>
      <div class="header-actions">
        <button @click="openSummary">Open summary</button>
        <button @click="seedMore">Seed more notes</button>
      </div>
    </header>

    <TextField label="Search" v-model="search" />

    <AsyncStats
      :total="notes.length"
      :active="activeCount"
      :archived="archivedCount"
    />

    <nav class="filters">
      <button @click="showAll">All</button>
      <button @click="showActive">Active</button>
      <button @click="showArchived">Archived</button>
    </nav>

    <section class="notes">
      <NoteCard
        v-for="note in filteredNotes"
        :key="note.id"
        :note="note"
        @archive="archiveNote"
        @restore="restoreNote"
      >
        <small>{{ note.statusLabel }}</small>
      </NoteCard>
    </section>

    <Teleport to="#modal-root">
      <section v-if="summaryOpen" class="summary-modal" role="dialog">
        <div class="summary-card">
          <strong>Teleported summary</strong>
          <p>{{ activeCount }} active notes and {{ archivedCount }} archived notes.</p>
          <button @click="closeSummary">Close summary</button>
        </div>
      </section>
    </Teleport>
  </main>
</template>

<script>
import { computed, defineAsyncComponent, ref } from "mikuru";
import TextField from "./TextField.mikuru";
import NoteCard from "./NoteCard.mikuru";

const LoadingStats = {
  mount(target) {
    const panel = document.createElement("aside");
    panel.className = "stats-loading";
    panel.textContent = "Loading note stats...";
    target.appendChild(panel);
    return {
      element: panel,
      unmount() {
        panel.remove();
      }
    };
  }
};

const AsyncStats = defineAsyncComponent({
  loader: () => new Promise((resolve) => {
    setTimeout(() => {
      import("./StatsPanel.mikuru").then(resolve);
    }, 300);
  }),
  loadingComponent: LoadingStats
});

const search = ref("");
const filter = ref("all");
const summaryOpen = ref(false);
const notes = ref([
  {
    id: "parser",
    title: "Parser limits should stay loud",
    body: "Compile errors should include a focused code frame.",
    owner: "Compiler",
    archived: true,
    statusLabel: "Archived"
  },
  {
    id: "scoped",
    title: "Scoped CSS works for simple selectors",
    body: "Basic selector rewriting keeps component styles local.",
    owner: "Runtime",
    archived: false,
    statusLabel: "Active"
  },
  {
    id: "cleanup",
    title: "Unmount cleanup under filters",
    body: "Effects and event listeners should be released predictably.",
    owner: "Runtime",
    archived: false,
    statusLabel: "Active"
  }
]);

const filteredNotes = computed(() => {
  const query = search.value.trim().toLowerCase();
  return notes.value.filter((note) => {
    const matchesFilter =
      filter.value === "all" ||
      (filter.value === "archived" ? note.archived : !note.archived);
    const matchesSearch =
      !query ||
      note.title.toLowerCase().includes(query) ||
      note.body.toLowerCase().includes(query) ||
      note.owner.toLowerCase().includes(query);
    return matchesFilter && matchesSearch;
  });
});

const activeCount = computed(() => notes.value.filter((note) => !note.archived).length);
const archivedCount = computed(() => notes.value.filter((note) => note.archived).length);

function setArchived(id, archived) {
  notes.value = notes.value.map((note) =>
    note.id === id
      ? {
          ...note,
          archived,
          statusLabel: archived ? "Archived" : "Active"
        }
      : note
  );
}

function archiveNote(id) {
  setArchived(id, true);
}

function restoreNote(id) {
  setArchived(id, false);
}

function seedMore() {
  if (notes.value.some((note) => note.id === "keyed")) {
    return;
  }

  notes.value = [
    ...notes.value,
    {
      id: "keyed",
      title: "Keyed lists keep card identity",
      body: "The generated keyed range should reuse card instances.",
      owner: "Compiler",
      archived: false,
      statusLabel: "Active"
    }
  ];
}

function openSummary() {
  summaryOpen.value = true;
}

function closeSummary() {
  summaryOpen.value = false;
}

function showAll() {
  filter.value = "all";
}

function showActive() {
  filter.value = "active";
}

function showArchived() {
  filter.value = "archived";
}
</script>

<style scoped>
.dogfood {
  display: grid;
  gap: 18px;
  max-width: 860px;
  margin: 36px auto;
  padding: 0 20px;
  font-family: system-ui, sans-serif;
}

header,
.filters {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.filters {
  justify-content: flex-start;
}

.header-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.notes {
  display: grid;
  gap: 12px;
}

.stats-loading {
  padding: 12px 14px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  color: #475569;
  background: #f8fafc;
}

.summary-modal {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(15, 23, 42, 0.45);
}

.summary-card {
  display: grid;
  gap: 10px;
  width: min(360px, 100%);
  padding: 18px;
  border-radius: 8px;
  background: #ffffff;
  box-shadow: 0 18px 45px rgba(15, 23, 42, 0.22);
}
</style>
