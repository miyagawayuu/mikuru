<template>
  <section class="ssr-card" data-testid="ssr-card">
    <h1>SSR Hydration Example</h1>
    <button @click="increment">count: {{ count }}</button>
    <p>{{ message }}</p>
  </section>
</template>

<script>
import { ref } from "mikuru";

const count = ref(Number(props.initialCount ?? 0));
const message = String(props.message ?? "Hydrated by Mikuru");

function increment() {
  count.value += 1;
}
</script>

