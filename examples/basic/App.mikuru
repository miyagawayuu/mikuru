<template>
  <section class="app">
    <h1>Mikuru Counter</h1>
    <button @click="increment">count: {{ count }}</button>
    <MoodBadge label="Mood" m-model="mood">
      <span>Current mood is {{ mood }}</span>
      <span>Settled mood is {{ delayedMood }}</span>
    </MoodBadge>
    <button @click="toggleDetails">Toggle note</button>
    <Transition name="note">
      <p m-if="showDetails" class="note">Transitions can animate conditional content.</p>
      <p m-else class="note note-muted">The note is hidden.</p>
    </Transition>
  </section>
</template>

<script>
import { onBeforeUnmount, ref, watch } from "mikuru";
import MoodBadge from "./MoodBadge.mikuru";

const count = ref(0);
const mood = ref("curious");
const delayedMood = ref(mood.value);
const showDetails = ref(true);

const stopMoodWatch = watch(mood, (nextMood, _previousMood, onCleanup) => {
  const timer = setTimeout(() => {
    delayedMood.value = nextMood;
  }, 200);

  onCleanup(() => {
    clearTimeout(timer);
  });
}, { immediate: true });

onBeforeUnmount(stopMoodWatch);

function increment() {
  count.value += 1;
  mood.value = count.value % 2 === 0 ? "curious" : "building";
}

function toggleDetails() {
  showDetails.value = !showDetails.value;
}
</script>

<style scoped>
.app {
  display: grid;
  gap: 16px;
  max-width: 520px;
  margin: 48px auto;
  font-family: system-ui, sans-serif;
}

button {
  font: inherit;
  width: fit-content;
}

.note {
  width: fit-content;
  margin: 0;
  padding: 10px 12px;
  color: #164e63;
  background: #ecfeff;
  border: 1px solid #a5f3fc;
  border-radius: 8px;
}

.note-muted {
  color: #475569;
  background: #f8fafc;
  border-color: #cbd5e1;
}

.note-enter-active,
.note-leave-active {
  transition: opacity 120ms ease, transform 120ms ease;
}

.note-enter-from,
.note-leave-to {
  opacity: 0;
  transform: translateY(-4px);
}

.note-enter-to,
.note-leave-from {
  opacity: 1;
  transform: translateY(0);
}
</style>
