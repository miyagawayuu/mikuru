<template>
  <div>
    <section m-show="currentPage === 'dashboard'">
      <DashboardPage @navigate="navigate" />
    </section>
    <section m-show="currentPage === 'login'">
      <LoginPage :redirectPath="redirectTarget" @navigate="navigate" />
    </section>
    <section m-show="currentPage === 'admin'">
      <AdminPage />
    </section>
    <section m-show="currentPage === 'notFound'">
      <NotFoundPage :path="currentPath" @navigate="navigate" />
    </section>
  </div>
</template>

<script>
import { createRouter } from "./app/router";
import AdminPage from "./pages/AdminPage.mikuru";
import DashboardPage from "./pages/DashboardPage.mikuru";
import LoginPage from "./pages/LoginPage.mikuru";
import NotFoundPage from "./pages/NotFoundPage.mikuru";

const { currentPage, currentPath, redirectTarget, start, navigate } = createRouter();
start();
</script>
