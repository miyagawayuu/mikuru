<template>
  <main class="page">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p>The route <code>{{ path }}</code> does not exist in this example app.</p>
    <UiButton @click="goHome">Back to board</UiButton>
  </main>
</template>

<script>
import UiButton from "../components/ui/Button.mikuru";

const { path } = defineProps();
const emit = defineEmits(["navigate"]);

function goHome() {
  emit("navigate", "/");
}
</script>

