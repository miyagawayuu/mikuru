<template>
  <label class="field">
    <span>{{ label }}</span>
    <input :value="modelValue" :placeholder="placeholder" :aria-label="label" :aria-invalid="error ? 'true' : 'false'" @input="updateValue" />
    <small m-if="error" class="error">{{ error }}</small>
  </label>
</template>

<script>
const { label, modelValue = "", placeholder = "", error = "" } = defineProps();
const emit = defineEmits(["update:modelValue"]);

function updateValue(event) {
  emit("update:modelValue", event.target.value);
}
</script>

<style scoped>
.field {
  display: grid;
  gap: 6px;
}

input {
  min-height: 38px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  color: inherit;
  font: inherit;
}

.error {
  color: #b91c1c;
}
</style>
