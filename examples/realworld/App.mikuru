<template>
  <main class="board" :class="{ compact: compact }">
    <header class="topbar">
      <h1>Release task board</h1>
      <button @click="toggleDensity">{{ densityLabel }}</button>
    </header>

    <section class="controls">
      <label>
        <span>Search tasks</span>
        <input v-model="search" aria-label="Search tasks" />
      </label>

      <label>
        <span>Owner</span>
        <select v-model="owner" aria-label="Owner">
          <option value="all">All</option>
          <option value="Compiler">Compiler</option>
          <option value="Runtime">Runtime</option>
          <option value="DX">DX</option>
        </select>
      </label>
    </section>

    <section class="new-task">
      <input v-model="newTitle" placeholder="New task title" />
      <select v-model="newOwner">
        <option value="Compiler">Compiler</option>
        <option value="Runtime">Runtime</option>
        <option value="DX">DX</option>
      </select>
      <button @click="addTask">Add task</button>
    </section>

    <section class="tasks">
      <article v-for="task in filteredTasks" :key="task.id" class="task-card">
        <strong>{{ task.title }}</strong>
        <span>{{ task.owner }} / {{ task.priority }}</span>
        <p>{{ task.detail }}</p>
      </article>
    </section>
  </main>
</template>

<script>
import { computed, ref } from "mikuru";

const search = ref("");
const owner = ref("all");
const compact = ref(false);
const newTitle = ref("");
const newOwner = ref("Compiler");
const tasks = ref([
  {
    id: "frames",
    title: "Code frames for parser failures",
    owner: "Compiler",
    priority: "high",
    detail: "Template errors should point to the exact broken expression."
  },
  {
    id: "cleanup",
    title: "Unmount cleanup under filters",
    owner: "Runtime",
    priority: "medium",
    detail: "Cleanup should remain stable while filters change."
  },
  {
    id: "package",
    title: "Published package smoke test",
    owner: "DX",
    priority: "medium",
    detail: "Verify package exports through a packed install."
  }
]);

const densityLabel = computed(() => (compact.value ? "Comfortable" : "Compact"));

const filteredTasks = computed(() => {
  const query = search.value.trim().toLowerCase();
  return tasks.value.filter((task) => {
    const ownerMatches = owner.value === "all" || task.owner === owner.value;
    const queryMatches =
      !query ||
      task.title.toLowerCase().includes(query) ||
      task.detail.toLowerCase().includes(query);
    return ownerMatches && queryMatches;
  });
});

function addTask() {
  const title = newTitle.value.trim();
  if (!title) {
    return;
  }

  tasks.value = [
    ...tasks.value,
    {
      id: `${Date.now()}`,
      title,
      owner: newOwner.value,
      priority: "medium",
      detail: `${newOwner.value} / medium`
    }
  ];
  newTitle.value = "";
}

function toggleDensity() {
  compact.value = !compact.value;
}
</script>

<style scoped>
.board {
  display: grid;
  gap: 18px;
  max-width: 960px;
  margin: 36px auto;
  padding: 0 20px;
  font-family: system-ui, sans-serif;
}

.topbar,
.controls,
.new-task {
  display: flex;
  align-items: end;
  gap: 12px;
  flex-wrap: wrap;
}

.topbar {
  justify-content: space-between;
}

label {
  display: grid;
  gap: 6px;
}

input,
select,
button {
  font: inherit;
  min-height: 36px;
}

.tasks {
  display: grid;
  gap: 12px;
}

.task-card {
  display: grid;
  gap: 6px;
  padding: 14px;
  border: 1px solid #d7dce2;
  border-radius: 8px;
  background: #ffffff;
}

.compact .task-card {
  padding: 8px 12px;
  gap: 2px;
}
</style>
