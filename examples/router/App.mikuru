<template>
  <main class="app">
    <header>
      <h1>Mikuru Router</h1>
      <nav>
        <RouterLink to="/" label="Home" />
        <RouterLink to="/start" label="Alias" />
        <RouterLink :to="userRoute">
          <span>User</span>
        </RouterLink>
        <RouterLink to="/legacy-user" label="Redirect" />
        <RouterLink :to="{ name: 'settings-profile' }" label="Settings" />
        <RouterLink :to="{ name: 'dynamic' }" label="Dynamic" />
        <RouterLink :to="{ name: 'lazy' }" label="Lazy" />
        <RouterLink :to="{ name: 'lazy-error' }" label="Lazy Error" />
        <RouterLink :to="{ name: 'admin' }" label="Admin" />
        <RouterLink to="/missing" label="Missing" />
      </nav>
    </header>

    <RouterView />
  </main>
</template>

<script>
import { onBeforeUnmount } from "mikuru";
import { createMemoryHistory, createRouter, provideRouter, RouterLink, RouterView } from "mikuru/router";
import AdminPage from "./AdminPage.mikuru";
import DynamicPage from "./DynamicPage.mikuru";
import ErrorPage from "./ErrorPage.mikuru";
import HomePage from "./HomePage.mikuru";
import LoadingPage from "./LoadingPage.mikuru";
import LoginPage from "./LoginPage.mikuru";
import NotFoundPage from "./NotFoundPage.mikuru";
import ProfilePage from "./ProfilePage.mikuru";
import SettingsPage from "./SettingsPage.mikuru";
import UserPage from "./UserPage.mikuru";

const userRoute = { name: "user", params: { id: "42" }, query: { tab: "profile" } };
const isLoggedIn = false;

const router = createRouter({
  history: createMemoryHistory("/"),
  routes: [
    { path: "/", name: "home", alias: "/start", component: HomePage },
    { path: "/login", name: "login", component: LoginPage },
    { path: "/legacy-user", redirect: userRoute },
    { path: "/users/:id", name: "user", component: UserPage },
    { path: "/lazy", name: "lazy", component: () => import("./LazyPage.mikuru"), loadingComponent: LoadingPage },
    {
      path: "/lazy-error",
      name: "lazy-error",
      component: async () => {
        throw new Error("Lazy route failed to load.");
      },
      errorComponent: ErrorPage
    },
    { path: "/admin", name: "admin", meta: { requiresAuth: true }, component: AdminPage },
    {
      path: "/settings",
      name: "settings",
      alias: "/preferences",
      component: SettingsPage,
      children: [{ path: "profile", name: "settings-profile", component: ProfilePage }]
    }
  ],
  notFound: NotFoundPage
});

router.addRoute({ path: "/dynamic", name: "dynamic", component: DynamicPage });
provideRouter(router);
router.beforeEach((to) => {
  if (to.meta.requiresAuth && !isLoggedIn) {
    return { name: "login", query: { redirect: to.fullPath } };
  }
  return undefined;
});

const stopRouter = router.listen();

onBeforeUnmount(stopRouter);
</script>

<style scoped>
.app {
  display: grid;
  gap: 24px;
  max-width: 720px;
  margin: 48px auto;
  padding: 0 20px;
  font-family: system-ui, sans-serif;
}

header {
  display: grid;
  gap: 12px;
}

nav {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

a {
  color: #2454c6;
}

a[aria-current="page"] {
  color: #111827;
  font-weight: 700;
}
</style>
