<template>
  <main class="app">
    <header>
      <h1>Mikuru Router</h1>
      <nav>
        <RouterLink :router="router" to="/" label="Home" />
        <RouterLink :router="router" to="/start" label="Alias" />
        <RouterLink :router="router" :to="userRoute">
          <span>User</span>
        </RouterLink>
        <RouterLink :router="router" to="/legacy-user" label="Redirect" />
        <RouterLink :router="router" :to="{ name: 'settings-profile' }" label="Settings" />
        <RouterLink :router="router" :to="{ name: 'dynamic' }" label="Dynamic" />
        <RouterLink :router="router" to="/missing" label="Missing" />
      </nav>
    </header>

    <RouterView :router="router" />
  </main>
</template>

<script>
import { onBeforeUnmount } from "mikuru";
import { createMemoryHistory, createRouter, RouterLink, RouterView } from "mikuru/router";
import DynamicPage from "./DynamicPage.mikuru";
import HomePage from "./HomePage.mikuru";
import NotFoundPage from "./NotFoundPage.mikuru";
import ProfilePage from "./ProfilePage.mikuru";
import SettingsPage from "./SettingsPage.mikuru";
import UserPage from "./UserPage.mikuru";

const userRoute = { name: "user", params: { id: "42" }, query: { tab: "profile" } };

const router = createRouter({
  history: createMemoryHistory("/"),
  routes: [
    { path: "/", name: "home", alias: "/start", component: HomePage },
    { path: "/legacy-user", redirect: userRoute },
    { path: "/users/:id", name: "user", component: UserPage },
    {
      path: "/settings",
      name: "settings",
      alias: "/preferences",
      component: SettingsPage,
      children: [{ path: "profile", name: "settings-profile", component: ProfilePage }]
    }
  ],
  notFound: NotFoundPage
});

router.addRoute({ path: "/dynamic", name: "dynamic", component: DynamicPage });

const stopRouter = router.listen();

onBeforeUnmount(stopRouter);
</script>

<style scoped>
.app {
  display: grid;
  gap: 24px;
  max-width: 720px;
  margin: 48px auto;
  padding: 0 20px;
  font-family: system-ui, sans-serif;
}

header {
  display: grid;
  gap: 12px;
}

nav {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

a {
  color: #2454c6;
}

a[aria-current="page"] {
  color: #111827;
  font-weight: 700;
}
</style>
